# ── Database ──────────────────────────────────────────────────────────
# IMPORTANT — who reads what:
#   · The running app (`npm run dev`) reads `.env.local` FIRST (it wins over
#     this file) → point it at the RLS-forced app role.
#   · The Prisma CLI (migrate/studio/seed) reads ONLY this file → owner role.
# So THIS file is the dev/prod switch for migrations: keep DEV active and
# PROD commented, flip it just while migrating prod, then flip it back.
# Runbook: .docs/MIGRACIONES-RUNBOOK.md
#
# ── DEV · local Docker (requires `docker compose up -d db`) ──  ACTIVE
# Host port is 5433 to avoid colliding with any other Postgres.
DATABASE_URL="postgresql://kinesoft:kinesoft@localhost:5433/kinesoft?schema=public"
DIRECT_URL="postgresql://kinesoft:kinesoft@localhost:5433/kinesoft?schema=public"
#
# ── PROD · Supabase ──  COMMENTED (uncomment ONLY to migrate prod)
# Use the DIRECT connection (5432) for BOTH — `prisma migrate` must not go
# through the pgbouncer pooler. Vercel's own DATABASE_URL does use the
# pooler (6543); that's configured in Vercel, not here.
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-[region].pooler.supabase.com:5432/postgres"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-[region].pooler.supabase.com:5432/postgres"

# Service channel (BYPASSRLS) for surfaces WITHOUT an Actor: Mercado Pago
# webhook, public booking, audit writes from jobs. Optional — when unset,
# lib/db.ts#prismaService falls back to DIRECT_URL (the owner connection).
#   Local:  leave blank → uses DIRECT_URL (`kinesoft`, the Docker superuser).
#   Prod:   the `kinesoft_service` (BYPASSRLS) role, via the transaction
#           pooler (6543) + pgbouncer=true. See prisma/roles.supabase.sql.
# DATABASE_URL_SERVICE="postgresql://kinesoft_service.[ref]:[password]@aws-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Mercado Pago ──────────────────────────────────────────────────────
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Observability (optional) ──────────────────────────────────────────
LOG_LEVEL="info"          # debug | info | warn | error
SENTRY_DSN=""

# ── Rate limiting ─────────────────────────────────────────────────────
# **REQUIRED FOR PRODUCTION.** Without Upstash, `lib/rate-limit.ts`
# falls back to an in-memory Map keyed per-process. On Vercel
# serverless every cold start resets counters and concurrent lambda
# isolates have independent buckets — so the limiter becomes
# advisory at best and the security gates (login throttling, public
# booking flood protection, MercadoPago webhook 60/min) stop working.
#
# Setup:
#   1. Create a free Redis at https://upstash.com (US-East works for
#      Vercel us-east-1; pick something close to your DB region for
#      EU/SA Supabase projects).
#   2. From the Upstash dashboard → "REST API" tab, copy the URL +
#      token. Both vars must be set; either alone is ignored.
#   3. After deploying, hit /api/auth/sign-in 10+ times to verify
#      the 429 surfaces.
#
# Local dev / single-replica deploys can leave both blank.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
