# ── Database ──────────────────────────────────────────────────────────
# Local dev (requires `docker compose up -d db`). Host port is 5433
# to avoid colliding with any other Postgres you may have running.
DATABASE_URL="postgresql://kinesoft:kinesoft@localhost:5433/kinesoft?schema=public"
DIRECT_URL="postgresql://kinesoft:kinesoft@localhost:5433/kinesoft?schema=public"
# Supabase Postgres (production):
# DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?schema=public"
# DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?schema=public"

# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Mercado Pago ──────────────────────────────────────────────────────
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Observability (optional) ──────────────────────────────────────────
LOG_LEVEL="info"          # debug | info | warn | error
SENTRY_DSN=""

# ── Rate limiting (optional) ──────────────────────────────────────────
# When empty the in-memory limiter is used (per-process). For production
# behind multiple replicas, point this at Upstash REST endpoint:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
