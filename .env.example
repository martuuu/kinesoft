# ── Database ──────────────────────────────────────────────────────────
# IMPORTANT — who reads what:
#   · The running app (`npm run dev`) reads `.env.local` FIRST (it wins over
#     this file) → point it at the RLS-forced app role.
#   · The Prisma CLI (migrate/studio/seed) reads ONLY this file → owner role.
# So THIS file is the dev/prod switch for migrations: keep DEV active and
# PROD commented, flip it just while migrating prod, then flip it back.
# Runbook: .docs/MIGRACIONES-RUNBOOK.md
#
# ── DEV · local Docker (requires `docker compose up -d db`) ──  ACTIVE
# Host port is 5433 to avoid colliding with any other Postgres.
DATABASE_URL="postgresql://kinesoft:kinesoft@localhost:5433/kinesoft?schema=public"
DIRECT_URL="postgresql://kinesoft:kinesoft@localhost:5433/kinesoft?schema=public"
#
# ── PROD · Supabase ──  COMMENTED (uncomment ONLY to migrate prod)
# Use the DIRECT connection (5432) for BOTH — `prisma migrate` must not go
# through the pgbouncer pooler. Vercel's own DATABASE_URL does use the
# pooler (6543); that's configured in Vercel, not here.
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-[region].pooler.supabase.com:5432/postgres"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-[region].pooler.supabase.com:5432/postgres"

# Service channel (BYPASSRLS) for surfaces WITHOUT an Actor: Mercado Pago
# webhook, public booking, audit writes from jobs. Optional — when unset,
# lib/db.ts#prismaService falls back to DIRECT_URL (the owner connection).
#   Local:  leave blank → uses DIRECT_URL (`kinesoft`, the Docker superuser).
#   Prod:   the `kinesoft_service` (BYPASSRLS) role, via the transaction
#           pooler (6543) + pgbouncer=true. See prisma/roles.supabase.sql.
# DATABASE_URL_SERVICE="postgresql://kinesoft_service.[ref]:[password]@aws-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Sala de Espera en tiempo real (SV) ────────────────────────────────
# REALTIME_DRIVER: off (default) | local | supabase.
#   · off      → la app no publica ni abre sockets; se actualiza como antes.
#   · local    → bus en memoria + SSE, solo para `npm run dev` (un proceso).
#                Production lo rechaza: en Vercel cada lambda tiene su bus.
#   · supabase → Broadcast privado `tenant:<id>:agenda`. En Production exige
#                SUPABASE_JWT_SECRET + SUPABASE_SERVICE_ROLE_KEY +
#                NEXT_PUBLIC_SUPABASE_URL (si falta alguna, el deploy falla).
# REALTIME_DRIVER="local"
# SUPABASE_JWT_SECRET: secreto HS256 con el que el server firma el token del
#   canal (Dashboard → Settings → JWT). SERVER-ONLY, nunca NEXT_PUBLIC_: con
#   él se firma un token `authenticated` del proyecto.
# SUPABASE_JWT_SECRET=""
# SUPABASE_JWT_KID: opcional. Solo si el secreto es una clave HS256 del sistema
#   nuevo de JWT signing keys (va como `kid` en el header). Con el secreto
#   legacy se deja sin setear.
# SUPABASE_JWT_KID=""

# ── Mercado Pago ──────────────────────────────────────────────────────
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""
# TP-0 (§22.5): DEPRECADO desde T5 (C-TP2). Se acepta off | platform para no romper un deploy, pero nadie lo lee:
# el turnero cobra con la cuenta del profesional (MP_CONNECT_MODE). `platform` solo loguea un aviso al boot.
TURNERO_CHECKOUT=""

# ── Cobros online con la cuenta del vendedor (T5, C-TP2) ──────────────
# MP_CONNECT_MODE: off (default) | fake | sandbox | live.
#   fake = Mercado Pago FALSO local (/api/mp/fake/*, `npm run dev:mpfake`). El boot lo RECHAZA en Vercel
#          (VERCEL_ENV o VERCEL seteadas) y el getter lo baja a off: nunca llega a prod.
#   sandbox/live en Production exigen MP_OAUTH_CLIENT_ID/SECRET, SECRET_BOX_KEYS y, con firma `required`,
#   MP_CONNECT_WEBHOOK_SECRET.
MP_CONNECT_MODE=""
# Credenciales de la APLICACIÓN de MP (OAuth de vendedores). SERVER-ONLY.
MP_OAUTH_CLIENT_ID=""
MP_OAUTH_CLIENT_SECRET=""
# Secreto de «Webhooks» de la app de MP para la rama `?acct=` (el legado sigue con MP_WEBHOOK_SECRET).
MP_CONNECT_WEBHOOK_SECRET=""
# required (default) | fetch-only. fetch-only acepta notificaciones sin firma (igual re-pide el pago con el token
# de la cuenta). Se ajusta tras la prueba S3 del sandbox.
MP_CONNECT_WEBHOOK_SIGNATURE=""
# Cifrado en reposo de los tokens (lib/secret-box.ts): "k2:<base64 de 32 bytes>,k1:<base64 de 32 bytes>"; la primera
# sella, todas abren. kid [a-z0-9_-]{1,16}, «dev» reservado. Vacía en local = clave dev determinista (nunca en Vercel).
SECRET_BOX_KEYS=""

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Observability (optional) ──────────────────────────────────────────
LOG_LEVEL="info"          # debug | info | warn | error
SENTRY_DSN=""

# ── Rate limiting ─────────────────────────────────────────────────────
# **REQUIRED FOR PRODUCTION.** Without Upstash, `lib/rate-limit.ts`
# falls back to an in-memory Map keyed per-process. On Vercel
# serverless every cold start resets counters and concurrent lambda
# isolates have independent buckets — so the limiter becomes
# advisory at best and the security gates (login throttling, public
# booking flood protection, MercadoPago webhook 60/min) stop working.
#
# Setup:
#   1. Create a free Redis at https://upstash.com (US-East works for
#      Vercel us-east-1; pick something close to your DB region for
#      EU/SA Supabase projects).
#   2. From the Upstash dashboard → "REST API" tab, copy the URL +
#      token. Both vars must be set; either alone is ignored.
#   3. After deploying, hit /api/auth/sign-in 10+ times to verify
#      the 429 surfaces.
#
# Local dev / single-replica deploys can leave both blank.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Mail transaccional (IAM-0b) ───────────────────────────────────────
# La app manda todos los mails (invitaciones, reset, portal); Supabase solo
# emite los tokens. Por dónde sale cada mail lo decide lib/email/transport.ts:
#   · Production (VERCEL_ENV=production): Resend si están RESEND_API_KEY y
#     EMAIL_FROM; si falta alguna, NO sale nada (log) y se avisa al arrancar.
#     Un mail con links a localhost se BLOQUEA. EMAIL_TRANSPORT se ignora.
#   · Preview: nunca manda (corre contra la base de prod).
#   · Local: log por defecto; EMAIL_TRANSPORT="mailpit" para verlos en
#     http://localhost:8025 (docker compose --profile mail up -d mailpit);
#     EMAIL_TRANSPORT="resend" + key solo para probar el dominio a propósito
#     (scripts/diagnose-email.ts), y aun así bloquea links a localhost.
# RESEND_API_KEY es SERVER-ONLY: nunca con prefijo NEXT_PUBLIC_.
RESEND_API_KEY=""
# Formato: "KineSoft <no-reply@mail.tudominio.com>" (dominio verificado en
# Resend). Fuera de Production el default es KineSoft <no-reply@kinesoft.app>.
EMAIL_FROM=""
# resend | mailpit | log (vacío = log en local).
EMAIL_TRANSPORT=""
# Reply-To por defecto cuando el mail no lo trae (p. ej. soporte@tudominio.com).
EMAIL_REPLY_TO=""
# API HTTP de Mailpit (default http://localhost:8025).
MAILPIT_URL=""

# ── Plataforma (back-office, bloque BO) ─────────────────────────────────────
# Vacías = default. Cambiar cualquiera en Vercel pide REDEPLOY (se leen al boot).
# off | banner (default) | enforce: qué pasa con un consultorio con la prueba vencida (BO1).
TENANT_ACCESS_ENFORCEMENT=""
# open (default) | assisted: con assisted, /signup no crea consultorios nuevos (los da de alta Plataforma); unirse por invitación sigue andando (BO-D11).
SIGNUP_MODE=""
# off (default) | enforce: TOTP obligatorio para superadmins. Enrolarse con off en /plataforma-mfa/configurar ANTES de poner enforce (BO4).
PLATFORM_MFA_ENFORCEMENT=""
# HF-3 (D-HF7): pausa TEMPORAL de la 2FA de un superadmin. Vacía = sin pausa (default, lo normal).
# Formato: <userId>@AAAA-MM-DD (lista separada por coma). Vale hasta el fin de ese día en hora AR.
# Por qué: apagar el TOTP propio no alcanza (sin 2FA, cada acción de riesgo de Plataforma pide «Activá la verificación»).
# Falla cerrado: solo superadmin activo, solo su id, fecha a <=30 días (más lejos se ignora con un warn), mal formada se
# ignora entera, y nunca con PLATFORM_MFA_ENFORCEMENT=enforce. Cambiar o apagar la 2FA sigue pidiendo el código.
# RIESGO: mientras dure, con la contraseña sola se opera Plataforma entera. Contraseña única, 14 días, solo tu id, y
# borrarla apenas termine. Se ve una banda en Plataforma y en /cuenta/seguridad; cada step-up salteado deja un warn.
SUPERADMIN_2FA_BYPASS=""
# off (default) | on: cierra la app al público con un 503 (/mantenimiento). Sin bypass para superadmin (BO5-B).
MAINTENANCE_MODE=""
# Línea opcional que ve CUALQUIERA en /mantenimiento (se corta a 280): nada interno.
MAINTENANCE_MESSAGE=""
# Secreto de los cron de Vercel (Authorization: Bearer). Sin él no corren: 503 en Production, 401 fuera (BO5-A).
CRON_SECRET=""
# Email de soporte que muestran la banda de acceso, /suspendido y Plan y uso (mailto). Vacío → «escribile al equipo de KineSoft» sin link. Se inlinea en el build: cambiarlo pide redeploy.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# ── Planes, cobros y mensajes (bloque PL) ─────────────────────────────────────
# off (default) | manual | mp: cobro de la suscripción de los consultorios (PL-D16).
#   off    → no genera cargos ni habla con Mercado Pago (se deploya sin cobrar).
#   manual → el cron genera cargos y Plataforma imputa pagos y comprobantes a mano. Pasar acá recién cuando los
#            precios estén cargados en /plataforma/precios.
#   mp     → todo lo de manual Y ADEMÁS débito automático y «Pagar con MP» con el token de la plataforma
#            (MP_ACCESS_TOKEN + MP_WEBHOOK_SECRET, obligatorias en Production con mp). Desde T6 ya no es un alias de
#            manual. Pasar acá cuando scripts/diagnose-mp-subscriptions.ts --sandbox dé verde (lo corre Martin).
#   `npm run dev:mpfake` y el E2E corren con mp contra el Mercado Pago FALSO (literales de prueba, nunca de acá).
SAAS_BILLING_MODE=""
# Datos para transferir (alias, CBU, titular, CUIT), texto libre (se corta a 500). Sin ellos no se ofrece «Informar pago».
SAAS_BILLING_TRANSFER_INFO=""
# Piso del débito automático en centavos (entero > 0). Vacío = el default del código (1500 = $ 15).
MP_MIN_DEBIT_CENTS=""
# scope (default) | panel: scope = el checkout de la suscripción manda notification_url …?scope=saas; panel = sin
# notification_url, llega por el webhook configurado en el panel de MP.
SAAS_MP_CHECKOUT_NOTIFY=""
# Buzón del equipo de KineSoft que recibe el aviso de mensajes de consultorios y consultas de la landing.
# Vacío → los mensajes quedan en /plataforma → Mensajes, sin aviso por mail.
PLATFORM_INBOX_EMAIL=""

# off (default) | preview | public: directorio público /profesionales y /consultorios/* (DIR). off = 404.
DIRECTORY_MODE=""

# ── WhatsApp (T6, C-WA1) ──────────────────────────────────────────────
# WHATSAPP_MODE: off (default) | fake | sandbox | live.
#   off     → ningún aviso ni request a Meta, y cero queries extra al guardar turnos.
#   fake    → simulador de Meta local (/api/whatsapp/fake/*); lo usan `npm run dev:mpfake` y el E2E. El boot lo
#             RECHAZA en Vercel (VERCEL_ENV o VERCEL seteadas) y el getter lo baja a off.
#   sandbox → app de Meta en desarrollo (números de prueba). live → mensajes reales; en Preview se lee como off.
#   En Production, sandbox/live exigen WHATSAPP_APP_ID, WHATSAPP_APP_SECRET, WHATSAPP_CONFIG_ID,
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN y SECRET_BOX_KEYS (el token de cada consultorio se sella con secret-box).
WHATSAPP_MODE=""
# App de Meta (developers.facebook.com → tu app → Configuración básica). SERVER-ONLY. Meta firma el webhook con el App Secret.
WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET=""
# config_id de Embedded Signup (Facebook Login for Business → Configuraciones). No es secreto, pero sin él no hay alta.
WHATSAPP_CONFIG_ID=""
# Verify token del webhook (`hub.verify_token`): al menos 32 caracteres; generalo con `openssl rand -hex 24`.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Versión de la Graph API, formato vNN.0. Vacía = la fija del código (lib/env.ts WHATSAPP_GRAPH_VERSION_DEFAULT).
WHATSAPP_GRAPH_VERSION=""
# Vacía = alta clásica. whatsapp_business_app_onboarding = coexistencia con la app WhatsApp Business del celular.
WHATSAPP_SIGNUP_FEATURE=""

# ── Interruptores de emergencia (default prendido) ────────────────────
# off desregistra los service workers en el próximo load (PWA, MB-D6). Se inlinea en el build: cambiarlo pide redeploy.
NEXT_PUBLIC_PWA=""
# 0 | false | off apaga la subida firmada de archivos del paciente (vuelve al camino ≤ 4 MB por el server, FC-2f).
PATIENT_FILES_SIGNED_UPLOAD=""

# ── Sentry: subida de source maps en el build (opcional) ──────────────
# Solo con SENTRY_AUTH_TOKEN (+ org y proyecto) se suben los source maps (next.config.mjs). SERVER/BUILD-ONLY.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ── Solo local / scripts (nunca en Vercel) ────────────────────────────
# KINESOFT_ALLOW_DEMO_ACTOR=1 → `next dev` sin Supabase entra con el actor demo (nunca con NODE_ENV=production).
# KINESOFT_ALLOW_DEMO_ACTOR=
# PERF_TIMING=1 → cuenta y cronometra cada op de Prisma y manda Server-Timing (PF-0a). PERF_TIMING_IDLE_MS ajusta el corte.
# PERF_TIMING=
# PERF_TIMING_IDLE_MS=
# INF-DEV (§26.7): `npm run dev` se niega a arrancar contra un Supabase que no sea local (o que sea PROD_SUPABASE_REF);
# ALLOW_DEV_REMOTE_SUPABASE=1 lo permite a propósito. El comando diario recomendado es `npm run dev:local`.
# ALLOW_DEV_REMOTE_SUPABASE=
# Confirmación explícita para los scripts que tocan prod (`assertSafeTarget`): el ref del proyecto. Los corre Martin.
# KINESOFT_CONFIRM_PROD=
# Las pone Vercel (no se cargan a mano): VERCEL=1 y VERCEL_ENV=production|preview|development.
# VERCEL=
# VERCEL_ENV=
# CF-RT: NO se carga. `next.config.mjs` la deriva en build del VERCEL_GIT_COMMIT_SHA (hash corto) y manda el mismo
# valor en el header `x-build-id`; el realtime dice «Hay una versión nueva» solo si los dos difieren. En local queda vacía.
# NEXT_PUBLIC_BUILD_ID=

# ── Guard de Preview (OPS-1c) ─────────────────────────────────────────
# Ref del proyecto Supabase de PRODUCCIÓN (el <ref> de https://<ref>.supabase.co; no es secreto). Cargalo en Vercel
# en TODOS los scopes con el mismo valor. Un build de Preview cuya DATABASE_URL / DIRECT_URL / DATABASE_URL_SERVICE
# (host o usuario `postgres.<ref>` del pooler) o NEXT_PUBLIC_SUPABASE_URL lo contenga FALLA (lib/env.ts). En
# Production y local no hace nada; sin él, Preview solo avisa. En local dejalo vacío.
PROD_SUPABASE_REF=

# ── Pooler local (OPS-1b) ─────────────────────────────────────────────
# pgbouncer en modo transacción del perfil `pooler` (docker compose --profile pooler up -d pgbouncer), para
# `npm run test:pooler`. Solo si lo movés de 127.0.0.1:6433; el usuario y la contraseña salen de DATABASE_URL.
# POOLER_HOST=
# POOLER_PORT=
