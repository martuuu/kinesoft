# Optional template for fully-offline dev against the bundled Docker DB.
#
# Default workflow uses Supabase (configured in `.env`). Only use this
# file if you need to develop without internet — typically for plane
# flights, locked-down networks, or local schema experiments you don't
# want hitting the shared Supabase.
#
# How to activate:
#   1. cp .env.offline.example .env.local
#   2. docker compose up -d db
#   3. npx prisma migrate deploy
#   4. npm run prisma:seed
#   5. npm run dev
#
# Next.js loads `.env.local` *over* `.env`, so the localhost URLs below
# will take precedence while the file exists. Delete `.env.local` to go
# back to Supabase.

DATABASE_URL="postgresql://kinesoft:kinesoft@localhost:5433/kinesoft?schema=public"
DIRECT_URL="postgresql://kinesoft:kinesoft@localhost:5433/kinesoft?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="info"

# Local-only escape hatch for the auth guard. When set, `getActor()` falls
# back to the seeded "movare" tenant + first practitioner if there's no
# Supabase session. Refused in NODE_ENV=production by lib/session.ts.
KINESOFT_ALLOW_DEMO_ACTOR="1"
