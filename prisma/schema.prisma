// KineSoft — Prisma schema
// Multi-tenant SaaS for kinesiology practices.
// Per-tenant clinical data + a globally shared anatomy/condition/exercise catalog.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═════════════════════════════════════════════════════════════════════
// Tenancy & Auth
// ═════════════════════════════════════════════════════════════════════

model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  legalName   String?
  taxId       String?
  timezone    String   @default("America/Argentina/Buenos_Aires")
  currency    String   @default("ARS")
  palette     String   @default("sky")
  plan        TenantPlan @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  trialEndsAt DateTime?
  // EV0 (M2 tenant_verticals): vertical + plan → módulos (`modulesFor`). Default
  // KINESIOLOGY = lo que son todos los consultorios previos a EV0.
  vertical    TenantVertical @default(KINESIOLOGY)
  // EV0 (M2): switch del turnero público. Opt-in (EV-D2): nace apagado y se
  // prende desde Configuración o /plataforma (escritor único C-EV5).
  publicBookingEnabled Boolean @default(false)
  // When `true`, every practitioner of the tenant sees all patients +
  // bookings. When `false` (default), each practitioner only sees the
  // patients assigned to them (via `Patient.assignedPractitionerId`).
  sharedPatientView Boolean @default(false)
  // Working hours window for the agenda timeline + public booking
  // slot generator. Hours are integers 6..23 inclusive on each side
  // (start < end enforced at the action layer). Default 8..19 matches
  // the pre-Sprint 17 hardcoded constants so existing tenants don't
  // see their agenda change after the migration.
  businessHoursStart Int @default(8)
  businessHoursEnd   Int @default(19)
  // Agenda row granularity in minutes: 60 (one row per hour) or 30 (half-hour
  // rows, so a 13:30 turno gets its own labelled row instead of being folded
  // into 13:00). Display-only — bookings have always stored exact minutes.
  agendaSlotMinutes  Int @default(60)
  // A3c (tenant_onboarding): el stepper de alta self-service marca el fin con
  // `onboardingCompletedAt`; null = el layout manda a /onboarding. La migración
  // backfillea los tenants existentes con su createdAt. Datos de contacto
  // públicos del consultorio (la dirección llega con Location en B-pre).
  onboardingCompletedAt DateTime?
  phone                 String?
  whatsapp              String?
  publicEmail           String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     Membership[]
  practitioners   Practitioner[]
  patients        Patient[]
  patientShares   PatientShare[]
  patientLinks    PatientTenantLink[]
  services        Service[]
  bookings        Booking[]
  programs        TreatmentProgram[]
  cases           ClinicalCase[]
  auditEvents     AuditEvent[]
  exercises       Exercise[]
  planTemplates   PlanTemplate[]
  favorites       Favorite[]
  insurers        Insurer[]
  invitations     Invitation[]
  customConditions Condition[]
  payerPlans              PayerPlan[]
  // B-pre M-agenda (agenda_foundations)
  locations               Location[]
  practitionerSchedules   PractitionerSchedule[]
  scheduleExceptions      ScheduleException[]
  timeBlocks              TimeBlock[]
  practitionerServices    PractitionerService[]
  practitionerPayers      PractitionerPayer[]
  practitionerSpecialties PractitionerSpecialty[]
  // Planes M1 (plans_booking_link)
  programAuthorizations   ProgramAuthorization[]
  patientChangeRequests   PatientChangeRequest[]
  // SR M4 (rooms)
  rooms                   Room[]

  @@index([slug])
}

// EV0 (M2 tenant_verticals, 07-oct): el plan solo cambia módulos en la vertical
// KINESIOLOGY (matriz en `lib/tenant-modules.ts`, plan §15.3). En GENERAL el plan
// hoy no cambia módulos.
enum TenantPlan {
  FREE        // Kine sin suscripción: ejercicios solo propios; sin plantillas ni favoritos
  STARTER     // Kine "Base": ejercicios solo propios + plantillas y favoritos
  PRO         // Kine PRO: lo de Base + todo el catálogo global cargado en Plataforma
  ENTERPRISE  // futuro: = PRO (+ SSO, retención de auditoría, multi-sede)
}

// EV0 (M2 tenant_verticals): tipo de consultorio. GENERAL = consultorio genérico
// (agenda, pacientes, cobros, obras sociales, sala de espera; sin Planes,
// Sesiones, Diagnóstico ni Ejercicios). KINESIOLOGY = kine + osteo (todo).
// Solo lo escribe `lib/tenant-entitlements-internal.ts` (C-EV5) después del alta.
enum TenantVertical {
  GENERAL
  KINESIOLOGY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}

model UserProfile {
  id           String        @id // Supabase auth user id
  email        String        @unique
  fullName     String?
  avatarUrl    String?
  locale       String        @default("es-AR")
  // Platform superadmin (cross-tenant): authors the global exercise catalog +
  // the "Plataforma" owner panel. Orthogonal to the tenant-scoped Role enum.
  isPlatformAdmin Boolean     @default(false)
  createdAt    DateTime      @default(now())

  memberships  Membership[]
  practitioner Practitioner?
  // Planes M1 (PD-14): una cuenta del portal se vincula a fichas distintas en N
  // consultorios. `Patient.userId` es único POR CONSULTORIO, ya no global → 1:n.
  patients     Patient[]
  customConditionsCreated Condition[] @relation("CustomConditionAuthor")
}

model Membership {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String
  role         Role
  invitedAt    DateTime @default(now())
  acceptedAt   DateTime?

  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

enum Role {
  OWNER
  ADMIN
  PRACTITIONER
  ASSISTANT
  BILLING
}

// ═════════════════════════════════════════════════════════════════════
// People
// ═════════════════════════════════════════════════════════════════════

model Practitioner {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String   @unique
  licenseNumber String?  // "Matrícula Nacional"
  specialty     String?
  bio           String?
  rating        Float?
  yearsExp      Int?
  createdAt     DateTime @default(now())

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          UserProfile @relation(fields: [userId], references: [id])
  services      Service[]
  bookings      Booking[]
  assignedPatients Patient[] @relation("AssignedPatients")
  sharedPatients PatientShare[]
  sessions      Session[]
  cases         ClinicalCase[]
  planTemplates PlanTemplate[]
  // B-pre M-agenda (agenda_foundations)
  schedules            PractitionerSchedule[]
  scheduleExceptions   ScheduleException[]
  timeBlocks           TimeBlock[]
  practitionerServices PractitionerService[]
  payers               PractitionerPayer[]
  specialties          PractitionerSpecialty[]
  // Planes M1: profesional responsable del plan (D17). RESTRICT.
  programs             TreatmentProgram[]

  @@index([tenantId])
}

model Patient {
  id            String   @id @default(cuid())
  tenantId      String   // home tenant (the first clinic to register them)
  // Optional Supabase identity for portal access. Planes M1 (PD-14, excepción a
  // "todo aditivo" aprobada por Martin el 03-oct): ya NO es único global
  // (`Patient_userId_key` se borró); es único por consultorio
  // (`Patient_tenantId_userId_key`, abajo). Buscar siempre por (tenantId, userId).
  userId        String?
  // The kine that "owns" this patient. Always set in Sprint 16+: every
  // patient is owned by exactly one practitioner (the one that loaded
  // them). Owners see the full HC by default; other kines see "basic"
  // info (nombre / DNI / próximo turno) unless explicitly shared via
  // `PatientShare`. `Tenant.sharedPatientView=true` overrides the
  // restriction and grants every member full access.
  assignedPractitionerId String?
  firstName     String
  lastName      String
  email         String?
  phone         String?
  dateOfBirth   DateTime?
  documentId    String?  // DNI
  notes         String?
  // Patient-level "active diagnosis" — a short mini-title + a longer note the
  // kine sets once and that auto-fills every NEW turno (Booking.title /
  // .description) so cards/history always carry it. Overridable per turno.
  diagnosisTitle String?
  diagnosisNote  String?
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  user         UserProfile? @relation(fields: [userId], references: [id])
  assignedPractitioner Practitioner? @relation("AssignedPatients", fields: [assignedPractitionerId], references: [id])
  coverages    Coverage[]
  bookings     Booking[]
  programs     TreatmentProgram[]
  tenantLinks  PatientTenantLink[]
  evaScores    EvaScore[]
  emergency    EmergencyContact[]
  files        PatientFile[]
  shares       PatientShare[]
  changeRequests PatientChangeRequest[]

  // Uniqueness within a tenant. On PostgreSQL a composite UNIQUE treats
  // NULLs as distinct, so these enforce "no duplicate VALUE" while still
  // allowing many patients with no email / phone / DNI:
  //   - documentId (DNI): required at the form layer (Zod), unique here.
  //   - email / phone: optional, but no two patients may share the same
  //     non-null value in the same consultorio.
  @@unique([tenantId, documentId])
  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  // Planes M1: una ficha por (consultorio, cuenta del portal) — PD-14.
  @@unique([tenantId, userId], map: "Patient_tenantId_userId_key")
  // Planes M1: destino de la FK compuesta de PatientChangeRequest.
  @@unique([id, tenantId], map: "Patient_id_tenantId_key")
  @@index([tenantId, lastName])
  @@index([tenantId, assignedPractitionerId])
}

// Explicit per-practitioner share of a patient HC. A row here grants
// the named practitioner FULL access to the patient (same as owner)
// for as long as the row exists. Combined with
// Patient.assignedPractitionerId it forms the access-control matrix
// consumed by patientAccessFor() in lib/visibility.ts.
//
// Audit trail lives in AuditEvent (action: patient.share / patient.unshare).
// sharedById records who granted the access.
model PatientShare {
  id              String   @id @default(cuid())
  tenantId        String
  patientId       String
  practitionerId  String   // the kine who gains access
  sharedById      String?  // UserProfile id of the kine who granted access
  sharedAt        DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@unique([patientId, practitionerId])
  @@index([tenantId, practitionerId])
  @@index([patientId])
}

// ═════════════════════════════════════════════════════════════════════
// Patient files — Archivos tab on the EHR.
// Metadata lives in Postgres; the binary lives in Supabase Storage (or
// any S3-compatible bucket). `storageKey` is the object key.
// ═════════════════════════════════════════════════════════════════════
enum PatientFileCategory {
  REPORT       // Informe médico / RMI / estudios
  DERIVATION   // Derivación / orden
  CONSENT      // Consentimiento informado
  IMAGE        // Foto / video clínico
  RECEIPT      // Recibo / factura
  OTHER
}

model PatientFile {
  id          String   @id @default(cuid())
  tenantId    String   // duplicated for fast tenant filtering
  patientId   String
  uploaderId  String?  // UserProfile id
  name        String
  mime        String
  sizeBytes   Int
  storageKey  String   // path in object storage (or "stub:<id>" in local dev)
  category    PatientFileCategory @default(OTHER)
  description String?
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
}

// Same human (one Supabase identity) can be a patient at multiple clinics.
model PatientTenantLink {
  id        String   @id @default(cuid())
  patientId String
  tenantId  String
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([patientId, tenantId])
}

model Coverage {
  id           String   @id @default(cuid())
  patientId    String
  // `insurer` is the legacy free-form name (kept as a cached display
  // string). When the practitioner picks an `Insurer` row from the
  // tenant catalogue, `insurerId` points to it and copago/fixedFee are
  // resolved through that. When the field is left as free-form text,
  // `insurerId` stays null and the booking falls back to "particular".
  insurer      String
  insurerId    String?
  // B-pre M-cat (expand): plan del catálogo global de prestadoras. `planName`
  // sigue siendo el texto libre/cache de display; null = sin vincular. Sin
  // auto-link en la migración: lo vincula el usuario desde la UI.
  payerPlanId String?
  planName     String?
  memberId     String?
  // Per-patient copago override (cents). When set, it takes precedence over
  // the insurer's configured copago (or the Particular price) for THIS
  // patient — set via the "¿Actualizar el copago?" prompt in the booking
  // modal. Null = fall through to the insurer / Particular default.
  copagoCents  Int?
  validUntil   DateTime?

  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  insurerRef   Insurer?  @relation(fields: [insurerId], references: [id])
  payerPlan  PayerPlan? @relation(fields: [payerPlanId], references: [id], onDelete: SetNull)

  @@index([insurerId])
  @@index([payerPlanId])
}

// Per-tenant insurer catalogue (Obras Sociales / Prepagas). Each row
// carries the copago the patient pays per session + the fixed fee the
// insurer reimburses the practitioner.
model Insurer {
  id            String   @id @default(cuid())
  tenantId      String
  name          String   // "OSDE", "Swiss Medical", "IOMA", etc.
  copagoCents   Int      @default(0)   // patient pays per session
  fixedFeeCents Int      @default(0)   // insurer pays kine per session
  // Marks the special "Particular" (out-of-pocket) row that every tenant
  // has exactly one of. It behaves like any other insurer for pricing
  // (the practitioner sets its copago = the particular price), but billing
  // never prints its name and the dashboard counts it as PRIVATE revenue,
  // not obra-social revenue. A patient "without obra social" simply has a
  // Coverage pointing at this row.
  isParticular  Boolean  @default(false)
  active        Boolean  @default(true)
  notes         String?
  // B-pre M-cat (expand): vínculo opcional a la prestadora del catálogo global.
  // El Insurer sigue siendo del tenant (precio/copago propios); `payerId` solo
  // dice "es esta obra social". Null = sin vincular (no hay auto-link).
  payerId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payer              Payer?              @relation(fields: [payerId], references: [id], onDelete: SetNull)
  coverages Coverage[]
  practitionerPayers PractitionerPayer[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, payerId])
}

// Pending invitations. The OWNER (Subscriber) issues these; the invitee
// receives the URL `/invite/<token>` and signs up through Supabase to
// accept. On acceptance we create UserProfile + Practitioner + Membership
// rows and stamp `acceptedAt` here.
model Invitation {
  id          String   @id @default(cuid())
  tenantId    String
  email       String
  firstName   String
  lastName    String
  role        Role     @default(PRACTITIONER)
  specialty   String?
  token       String   @unique
  invitedById String   // UserProfile id of the OWNER who created the invite
  invitedAt   DateTime @default(now())
  acceptedAt  DateTime?
  expiresAt   DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model EmergencyContact {
  id        String  @id @default(cuid())
  patientId String
  name      String
  relation  String?
  phone     String

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// ═════════════════════════════════════════════════════════════════════
// Anatomy & Condition Catalog  (GLOBAL — not tenant-scoped)
// ═════════════════════════════════════════════════════════════════════

enum TagKind {
  ZONE          // tobillo, rodilla
  SUBZONE       // lateral, medial, posterior
  SYMPTOM       // punzante, sordo, quemante
  TRIGGER       // reposo, escaleras, correr
  PHASE         // aguda, subaguda, crónica
  EQUIPMENT     // banda, mancuernas, ninguno (a.k.a. "elementos" en la UI)
  GOAL          // movilidad, fuerza, estabilidad
  CHAIN         // marker for kinematic-chain relations (e.g. "glute-med", "core")
  MUSCLE_GROUP  // grupo muscular: glúteo medio, cuádriceps, ...
  DISCIPLINE    // rama de kinesiología: deportiva, respiratoria, neuro, osteopatía, ...
}

model Tag {
  id        String  @id @default(cuid())
  slug      String  @unique
  label     String
  kind      TagKind
  parentId  String?
  parent    Tag?    @relation("TagTree", fields: [parentId], references: [id])
  children  Tag[]   @relation("TagTree")

  conditions ConditionTag[]
  exercises  ExerciseTag[]

  @@index([kind])
  @@index([parentId])
}

model Condition {
  id               String   @id @default(cuid())
  cie10            String?
  // Global rows have a stable slug — used for deep-linking + the
  // matching engine. Custom (tenant-scoped) rows still have a slug
  // but it's auto-generated from name and only unique within the
  // owning tenant (enforced via `[tenantId, slug]` below).
  slug             String   @unique
  name             String
  summary          String?
  contra           String?  // contraindications, plain text
  severity         Severity?
  recoveryWeeksMin Int?
  recoveryWeeksMax Int?
  mechanism        String?  // "Sobrecarga", "Trauma", "Repetitivo", "Postural"
  redFlags         String?  // when to refer urgently
  // Sprint 17: tenant-scoped custom conditions.
  // - `tenantId == null` → global catalog (seeded). Visible to every
  //   tenant. Linked to anatomy / tag / exercise via the relations
  //   below — drives the matching engine on the diagnostico screen.
  // - `tenantId != null` → practitioner-created override. NOT linked
  //   to anatomy or the matching engine; surfaced in `AssignPlanModal`
  //   as a manual override and persisted on the ClinicalCase as the
  //   confirmed diagnosis. Exercises are whatever the kine attaches
  //   via the extras picker.
  tenantId         String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())

  tenant    Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy UserProfile? @relation("CustomConditionAuthor", fields: [createdById], references: [id])

  tags      ConditionTag[]
  anatomy   ConditionAnatomy[]
  exercises ConditionExerciseLink[]
  diagnoses Diagnosis[]

  @@index([tenantId])
}

enum Severity {
  MILD
  MODERATE
  SEVERE
}

model ConditionTag {
  conditionId String
  tagId       String
  weight      Float  @default(1.0)
  // when this condition matches, the tag contributes `weight` to its score

  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id])

  @@id([conditionId, tagId])
}

enum ExerciseKind {
  EXERCISE        // Equipment-based / patient-performed exercise
  MANUAL_THERAPY  // Practitioner-performed manual maneuver / soft tissue work
}

model Exercise {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  description  String?
  videoUrl     String?
  difficulty   Int     @default(1)        // 1..5
  // Series/reps/tiempo son OPCIONALES: un ejercicio puede ser solo lectura o
  // basarse en tiempo (isométricos). El picker de sesión cae a 3×12 cuando null.
  defaultSets     Int?
  defaultReps     Int?
  durationSeconds Int?    // ejercicios por tiempo (planchas, isométricos)
  instructions String? // markdown bullets
  equipment    String? // comma-separated: "banda, foam roller"
  muscleGroups String? // "Glúteo medio, Cadera"
  cues         String? // form cues / coaching points
  // EXERCISE (default) → patient-performed item with sets/reps. Lives in
  // the Biblioteca de Ejercicios. MANUAL_THERAPY → practitioner-performed
  // maneuver / soft tissue work. Lives in the Terapia Manual catalogue
  // but is appendable to the same SessionExercise list, so a session can
  // mix 2 ejercicios + 1 maniobra. The picker UI colours them differently.
  kind         ExerciseKind @default(EXERCISE)
  // Visibility: tenantId NULL = global catalog (PRO/ENTERPRISE only).
  // tenantId set = private to that tenant. `isBasic` = visible to FREE/STARTER.
  tenantId     String?
  createdById  String?  // UserProfile id of the practitioner who authored
  isBasic      Boolean  @default(false)
  // Soft-delete: archived exercises drop out of catalog browse but stay
  // referenceable by historical SessionExercise / ConditionExerciseLink rows.
  archivedAt   DateTime?
  createdAt    DateTime @default(now())

  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags        ExerciseTag[]
  conditions  ConditionExerciseLink[]
  sessions    SessionExercise[]
  favorites   Favorite[]
  media       ExerciseMedia[]
  article     ExerciseArticle?

  @@index([tenantId])
  @@index([isBasic])
  @@index([kind])
  @@index([archivedAt])
}

// Media backing an exercise (several per exercise, ordered). Uploaded assets
// (VIDEO/IMAGE/GIF) store a Supabase storage key in `url`; YOUTUBE stores the
// raw watch URL (rendered as a youtube-nocookie iframe). Global catalog only
// (no tenantId): visibility is inherited from the parent Exercise at read time.
enum ExerciseMediaType {
  VIDEO
  IMAGE
  GIF
  YOUTUBE
}

model ExerciseMedia {
  id         String            @id @default(cuid())
  exerciseId String
  type       ExerciseMediaType
  url        String            // storage key (upload) or youtube url
  caption    String?
  order      Int               @default(0)
  createdAt  DateTime          @default(now())

  exercise   Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, order])
}

// Long-form "Ejercicio completo" article (1:1, optional). Blogpost-style
// reader content the kine fills over time. Global catalog only (no tenantId).
model ExerciseArticle {
  id             String   @id @default(cuid())
  exerciseId     String   @unique
  title          String?
  subtitle       String?
  focus          String?  // "enfoque": qué trabaja / para qué sirve
  readingMinutes Int?
  bodyMarkdown   String?  // safe-rendered server-side (no raw HTML)
  references     String?  // quotes / citations (markdown or JSON)
  updatedAt      DateTime @updatedAt @default(now())

  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

// Per-user starred exercises. Surfaced as a filter chip in the Biblioteca.
model Favorite {
  id         String   @id @default(cuid())
  userId     String   // UserProfile id
  exerciseId String
  tenantId   String   // for quick filtering by active tenant
  createdAt  DateTime @default(now())

  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([tenantId, userId])
}

// Reusable plan templates ("my plans") — practitioner-curated session
// scaffolds that can be applied to any patient. exerciseIds stores the
// ordered list as JSON so we don't need a join table for the template.
model PlanTemplate {
  id            String   @id @default(cuid())
  tenantId      String
  authorId      String   // Practitioner id
  name          String
  description   String?
  totalSessions Int      @default(10)
  frequency     Int      @default(2)
  exerciseIds   Json     // string[] in the canonical order
  // Planes M1: lo necesario para prellenar el editor. CHECKs en SQL (ver bloque
  // de comentario "Planes M1" al final): pricing, precios >= 0, duración 15..240
  // y schedule objeto. Limpiar `schedule` con Prisma.DbNull, NUNCA JsonNull.
  discipline           Discipline?
  serviceId            String?
  durationMin          Int?
  schedule             Json?
  pricingMode          ProgramPricingMode?
  pricePerSessionCents Int?
  totalPriceCents      Int?
  notes                String?
  archivedAt           DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author  Practitioner @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // SET NULL: deleteTenantDeep borra Service antes del cascade del tenant.
  service  Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  programs TreatmentProgram[]

  @@index([tenantId, authorId])
  @@index([serviceId], map: "PlanTemplate_serviceId_idx")
  @@index([tenantId, discipline], map: "PlanTemplate_tenantId_discipline_idx")
}

model ExerciseTag {
  exerciseId String
  tagId      String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@id([exerciseId, tagId])
}

enum ExerciseRelation {
  DIRECT
  INDIRECT      // related via kinematic chain (e.g. ITBS → glute med)
  ANTAGONIST    // balances/counteracts
  PREVENTIVE
}

enum ProgramPhase {
  ACTIVATION    // activation / dosage of dormant muscles
  STABILITY     // motor control + lumbo-pelvic stability
  LOAD          // progressive resistance
  PROGRESSION   // sport-specific / return to play
}

// The crown jewel: condition ↔ exercise links with semantics + weight + phase.
model ConditionExerciseLink {
  conditionId String
  exerciseId  String
  relation    ExerciseRelation
  phase       ProgramPhase @default(ACTIVATION)
  weight      Float        @default(1.0)
  rationale   String?  // e.g. "kinematic chain: glute med insufficiency drives ITB tension"

  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  exercise  Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([conditionId, exerciseId, relation])
  @@index([conditionId])
  @@index([exerciseId])
}

// ═════════════════════════════════════════════════════════════════════
// Anatomical regions — drives the interactive body map AND the matching
// engine's spatial scoring. Each region has SVG geometry so the body map
// renders from data, and an optional `tagSlug` linking it to the Tag tree
// for the unified scoring algorithm.
// ═════════════════════════════════════════════════════════════════════

enum AnatomicalView {
  FRONT
  BACK
}

enum BodySide {
  LEFT
  RIGHT
  CENTER
}

enum ShapeKind {
  RECT
  ELLIPSE
  PATH
}

enum AnatomyRole {
  PRIMARY      // condition lives here
  SECONDARY    // condition also involves
  RELATED      // kinematic chain — surfaces "indirect" exercises
}

model AnatomicalRegion {
  slug        String         @id
  label       String
  view        AnatomicalView
  side        BodySide       @default(CENTER)
  parentSlug  String?
  parent      AnatomicalRegion? @relation("RegionTree", fields: [parentSlug], references: [slug])
  children    AnatomicalRegion[] @relation("RegionTree")
  tagSlug     String?       // bridge into the Tag tree
  shape       ShapeKind     @default(ELLIPSE)
  x           Float?        // shared by RECT (top-left x) and ELLIPSE (cx)
  y           Float?        // shared by RECT (top-left y) and ELLIPSE (cy)
  width       Float?        // RECT
  height      Float?        // RECT
  rx          Float?        // ELLIPSE radius x  | RECT corner radius
  ry          Float?        // ELLIPSE radius y
  path        String?       // SVG path data for PATH
  sortOrder   Int           @default(0)

  conditions  ConditionAnatomy[]

  @@index([view, sortOrder])
}

model ConditionAnatomy {
  conditionId String
  regionSlug  String
  role        AnatomyRole

  condition Condition        @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  region    AnatomicalRegion @relation(fields: [regionSlug], references: [slug])

  @@id([conditionId, regionSlug, role])
  @@index([regionSlug])
}

// ═════════════════════════════════════════════════════════════════════
// Diagnosis flow  (per-tenant clinical artefacts)
// ═════════════════════════════════════════════════════════════════════

// Patient-agnostic snapshot from the Diagnosis page.
// Captures the practitioner's selections before any patient is assigned.
model ClinicalCase {
  id             String   @id @default(cuid())
  tenantId       String
  authorId       String   // practitioner
  // selections persisted as JSON for forward compat with the matching engine
  selectedZones  Json     // e.g. ["knee-lateral-right", "hip-external-right"]
  refinements    Json     // { sub-zones, symptoms, triggers, evolution, intensity }
  notes          String?
  patientId      String?  // becomes set when assigned to a patient
  createdAt      DateTime @default(now())

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  author       Practitioner   @relation(fields: [authorId], references: [id])
  diagnoses    Diagnosis[]
  program      TreatmentProgram?

  @@index([tenantId])
  @@index([patientId])
}

// One ranked condition for a case.
model Diagnosis {
  id          String   @id @default(cuid())
  caseId      String
  conditionId String
  matchScore  Float    // 0..1
  confirmed   Boolean  @default(false)
  rank        Int

  case      ClinicalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  condition Condition    @relation(fields: [conditionId], references: [id])

  @@index([caseId])
}

// ═════════════════════════════════════════════════════════════════════
// Treatment programs & sessions
// ═════════════════════════════════════════════════════════════════════

model TreatmentProgram {
  id           String   @id @default(cuid())
  tenantId     String
  patientId    String
  caseId       String?  @unique
  title        String
  totalSessions Int     @default(8)
  frequency    Int      @default(2) // per week
  startDate    DateTime
  status       ProgramStatus @default(ACTIVE)
  // Planes M1 (plans_booking_link). Todo nullable/default: el código viejo y los
  // planes legacy siguen válidos. CHECKs en SQL (bloque "Planes M1" al final).
  discipline           Discipline?
  practitionerId       String?   // profesional responsable (D17; backfill desde la 1ª sesión)
  serviceId            String?
  locationId           String?   // null = sede principal
  templateId           String?
  durationMin          Int?      // override; efectiva = override ?? PS ?? Service (15..240)
  // PlanScheduleV1. Limpiar con Prisma.DbNull, NUNCA Prisma.JsonNull: JsonNull
  // guarda un JSON null y viola TreatmentProgram_schedule_check (23514).
  schedule             Json?
  pricingMode          ProgramPricingMode?
  pricePerSessionCents Int?
  totalPriceCents      Int?
  notes                String?
  idempotencyKey       String?   // única POR TENANT (una global reabriría la fuga de A2)
  archivedAt           DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  patient  Patient       @relation(fields: [patientId], references: [id])
  case     ClinicalCase? @relation(fields: [caseId], references: [id])
  sessions Session[]
  // Planes M1. RESTRICT en profesional/servicio/sede (SET NULL movería el plan en
  // silencio); SET NULL en la plantilla.
  practitioner   Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  location       Location?     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  template       PlanTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  bookings       Booking[]
  authorizations ProgramAuthorization[]

  @@unique([tenantId, idempotencyKey], map: "TreatmentProgram_tenantId_idempotencyKey_key")
  // Destinos de las FKs compuestas (Booking_plan_tenant_fkey, Booking_plan_patient_fkey,
  // ProgramAuthorization_program_tenant_fkey).
  @@unique([id, tenantId], map: "TreatmentProgram_id_tenantId_key")
  @@unique([id, patientId], map: "TreatmentProgram_id_patientId_key")
  @@index([tenantId, discipline, status], map: "TreatmentProgram_tenantId_discipline_status_idx")
  @@index([practitionerId], map: "TreatmentProgram_practitionerId_idx")
  @@index([serviceId], map: "TreatmentProgram_serviceId_idx")
  @@index([locationId], map: "TreatmentProgram_locationId_idx")
  @@index([templateId], map: "TreatmentProgram_templateId_idx")
  @@index([tenantId, patientId])
  // Hot read: `getPatientProgramsLite/Full` orders programs per patient
  // by createdAt desc — this composite makes that an index-only scan.
  @@index([patientId, createdAt])
}

enum ProgramStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

// Planes M1 (D10).
enum Discipline {
  KINESIOLOGY
  OSTEOPATHY
}

// Planes M1 (I6). PER_SESSION = pricePerSessionCents; PACKAGE = totalPriceCents
// repartido en Session.priceCents (la cuota es la fuente de la verdad de la plata).
enum ProgramPricingMode {
  PER_SESSION
  PACKAGE
}

// Autorización de la obra social de un plan (Planes M1; PQ-01 = sí, PD-16, PQ-15).
// Historial: renovar = marcar la vigente con supersededAt + INSERT de la nueva.
// Una sola vigente por plan: índice único PARCIAL
// ProgramAuthorization_programId_current_key (WHERE supersededAt IS NULL), que
// Prisma no expresa. CHECKs en SQL: authorizedSessions 1..200, code 1..64 chars,
// expiresOn >= startsOn. RLS ENABLE + FORCE + ProgramAuthorization_tenant_isolation.
// Fechas de calendario en DATE: leer con dbDateToDayKey, escribir con dayKeyToDbDate.
model ProgramAuthorization {
  id                 String    @id @default(cuid())
  tenantId           String
  programId          String
  code               String?
  authorizedSessions Int?
  startsOn           DateTime  @db.Date
  expiresOn          DateTime? @db.Date
  createdById        String?
  createdAt          DateTime  @default(now())
  supersededAt       DateTime?

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "ProgramAuthorization_tenantId_fkey")
  // FK compuesta: bajo BYPASSRLS (prod) garantiza que el tenantId de la fila es el del plan.
  program TreatmentProgram @relation(fields: [programId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction, map: "ProgramAuthorization_program_tenant_fkey")

  @@index([tenantId, expiresOn], map: "ProgramAuthorization_tenantId_expiresOn_idx")
}

model Session {
  id           String   @id @default(cuid())
  programId    String
  practitionerId String
  index        Int       // 1..N
  scheduledFor DateTime
  completedAt  DateTime?
  notes        String?
  rpe          Int?      // perceived effort 0..10
  paInPre      Int?      // pain pre 0..10
  paInPost     Int?      // pain post 0..10
  // Planes M1. `index` es estable: archivar NO renumera. Único PARCIAL
  // Session_programId_index_live_key (programId, index) WHERE archivedAt IS NULL
  // (no lo expresa Prisma). CHECK Session_priceCents_check (>= 0).
  title        String?
  priceCents   Int?      // la cuota: fuente de la verdad de la plata (I6)
  archivedAt   DateTime?
  updatedAt    DateTime  @default(now()) @updatedAt

  program      TreatmentProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  practitioner Practitioner     @relation(fields: [practitionerId], references: [id])
  exercises    SessionExercise[]
  bookings     Booking[]
  evaScores    EvaScore[]

  // Destino de la FK compuesta Booking_session_program_fkey.
  @@unique([id, programId], map: "Session_id_programId_key")
  @@index([programId])
  // Hot read: sessions are always loaded ordered by `index` within a
  // program. Composite avoids a sort step on every patient profile load.
  @@index([programId, index])
  // Hot read: dashboard "recent sessions" filters `completedAt IS NOT
  // NULL` then sorts by it descending. A partial index would be ideal
  // but Prisma doesn't expose them; this still helps the planner.
  @@index([completedAt])
}

model SessionExercise {
  id         String  @id @default(cuid())
  sessionId  String
  exerciseId String
  order      Int
  sets       Int
  reps       Int
  status     SessionExerciseStatus @default(PENDING)
  notes      String?

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([sessionId, order])
}

enum SessionExerciseStatus {
  PENDING
  DONE
  SKIPPED
  PROGRESSED
}

// Visual Analog Scale data points for the patient's evolution chart.
model EvaScore {
  id        String   @id @default(cuid())
  patientId String
  takenAt   DateTime @default(now())
  value     Int      // 0..10
  source    String?  // "pre", "post", "weekly-checkin"
  // Planes M1: reemplaza al string ambiguo; las escrituras nuevas llenan ambos.
  note      String?
  sessionId String?

  patient Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([patientId, takenAt])
  @@index([sessionId], map: "EvaScore_sessionId_idx")
}

// ═════════════════════════════════════════════════════════════════════
// Scheduling & Payments
// ═════════════════════════════════════════════════════════════════════

model Service {
  id           String   @id @default(cuid())
  tenantId     String
  practitionerId String?
  name         String   // "Sesión kinésica"
  durationMin  Int      @default(45)
  priceCents   Int      @default(0)
  description  String?
  // Colour that identifies this service in the agenda (the card's left bar).
  // Stored as a fixed pastel HEX (not a palette key) so it stays stable
  // regardless of the user's theme. Null = fall back to the status colour.
  color        String?
  // Cupos simultáneos por horario. null = ilimitado (kinesiología atiende
  // varios pacientes en paralelo en la misma franja); 1 = un turno por horario
  // (osteopatía); N = tope de N turnos solapados.
  maxConcurrent Int?
  // B-pre M-cat (expand): práctica del catálogo global que este servicio
  // factura/representa. Null = servicio libre del consultorio.
  practiceId     String?
  // Planes M1 (D10).
  discipline     Discipline?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  practitioner Practitioner? @relation(fields: [practitionerId], references: [id])
  practice             Practice?             @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  bookings     Booking[]
  practitionerServices PractitionerService[]
  programs             TreatmentProgram[]
  planTemplates        PlanTemplate[]

  @@index([practiceId])
}

model Booking {
  id              String        @id @default(cuid())
  tenantId        String
  patientId       String?       // null while pending guest checkout
  practitionerId  String
  serviceId       String
  scheduledFor    DateTime
  durationMin     Int
  // Per-turno copago override (cents). Defaults to the patient's resolved
  // copago at creation time but the practitioner can adjust it for this one
  // turno. Null = compute from the patient's coverage on read.
  copagoCents     Int?
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  // When the obra social reimbursement for this turno was confirmed as
  // received (manual confirmation from the Facturación tab). Null = the OS
  // hasn't paid yet. The copago side is tracked via `paymentStatus`.
  insurerPaidAt   DateTime?
  // M3a (ES3, plan §16.2): cuándo se marcó cobrado el copago A MANO (no MP).
  // Lo escribe/limpia solo toggleBilling/setBookingCopagoPaid (marcar → now(),
  // desmarcar → null) y lo lee el widget de ingresos del dashboard por semana/
  // mes AR. No usar `updatedAt` para eso (lo mueve cualquier edición).
  copagoPaidAt    DateTime?
  // Groups the turnos created together in one multi-turno batch (the agenda
  // "Repetir / Múltiples turnos" flow). Null for single bookings. Lets a
  // future "plan" entity regroup a batch indirectly without a destructive
  // migration — the column is already populated.
  seriesId        String?
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  idempotencyKey  String        @unique
  notes           String?
  // Per-turno mini-diagnosis: a short title (shown on the agenda card in place
  // of the service name) + a longer description. Both optional; auto-filled
  // from the patient's default diagnosis at creation, overridable per turno.
  title           String?
  description     String?
  // B-pre M-agenda (expand). `locationId` null = sede principal del tenant (la
  // migración backfillea todos con la principal; el loader trata null igual).
  // RESTRICT: una sede con turnos no se borra (se desactiva con `active`).
  locationId      String?
  // Reemplaza al prefijo "[SOBRETURNO]" de `notes` (backfilleado desde ahí); el
  // prefijo se sigue escribiendo hasta el contract posterior a B-pre.
  isOverbooked    Boolean       @default(false)
  // Recepción (decisión 3 de B-pre): timestamps, no BookingStatus nuevos.
  arrivedAt       DateTime?
  attendingAt     DateTime?
  // Telemedicina (decisión 9): URL por turno.
  isTelemedicine  Boolean       @default(false)
  telemedicineUrl String?
  // Planes M1 (D25). programId y sessionId van juntos (Booking_plan_link_check);
  // un guest no es turno de plan (Booking_plan_patient_check). `pricedByPlan` solo
  // lo escribe el motor de Planes (I8; Booking_priced_by_plan_check). Las FKs
  // compuestas (I1/I4) y el único parcial Booking_session_active_key (I2) están en
  // el bloque de comentario "Planes M1" al final del schema.
  programId       String?
  sessionId       String?
  pricedByPlan    Boolean       @default(false)
  // SR M4 (rooms). Sala del turno; null = sin sala. Con sala, `locationId` es
  // explícito (Booking_room_location_check, SR-D6) y la sala es de ESA sede y de
  // este tenant (FKs compuestas, ver "SR M4: DRIFT ACEPTADO" al final). Quien
  // cambia la sede recalcula o limpia la sala en el mismo UPDATE (si no, 23503).
  roomId          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  patient      Patient?      @relation(fields: [patientId], references: [id])
  practitioner Practitioner  @relation(fields: [practitionerId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  payment      Payment?
  program      TreatmentProgram? @relation(fields: [programId], references: [id], onDelete: Restrict)
  session      Session?          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  // RESTRICT: una sala con turnos no se borra (se archiva con `active`).
  room         Room?             @relation(fields: [roomId], references: [id], onDelete: Restrict, map: "Booking_roomId_fkey")

  @@index([tenantId, scheduledFor])
  @@index([practitionerId, scheduledFor])
  // Hot read: patient profile bookings list filters by patientId and
  // orders by scheduledFor desc. The implicit FK index on patientId
  // alone wouldn't help the sort step.
  @@index([patientId, scheduledFor])
  @@index([tenantId, seriesId])
  @@index([tenantId, locationId, scheduledFor])
  @@index([tenantId, programId], map: "Booking_tenantId_programId_idx")
  // Chequeo RESTRICT al borrar una Session y "sin turno" derivado.
  @@index([sessionId], map: "Booking_sessionId_idx")
  // SR M4: ocupación de la sala, vista "Por sala" y chequeo del RESTRICT.
  @@index([tenantId, roomId, scheduledFor], map: "Booking_tenantId_roomId_scheduledFor_idx")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  REFUNDED
  FAILED
}

model Payment {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  provider        String   @default("mercadopago")
  externalId      String?  // MP preference/payment id
  status          PaymentStatus @default(UNPAID)
  // What the checkout preference was created for (cents). Anchored at
  // preference-creation time so the webhook validates the captured amount
  // against the price the patient actually agreed to — not a live
  // `Service.priceCents` that may have changed since. Null on legacy rows
  // created before this column; the webhook falls back to the service price.
  expectedAmountCents Int?
  amountCents     Int      // captured amount (0 until the webhook settles)
  currency        String   @default("ARS")
  rawPayload      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Restrict (not Cascade): deleting a Booking must NOT silently destroy its
  // Payment record. `deleteBooking` guards paid turnos and cleans up an
  // abandoned UNPAID/FAILED payment explicitly before deleting.
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([externalId])
}

// ═════════════════════════════════════════════════════════════════════
// Notifications — per-user feed surfaced in the dashboard bell.
// Created automatically by domain mutations (booking.create / payment.paid
// / session.due / program.completing).
// ═════════════════════════════════════════════════════════════════════
enum NotificationKind {
  BOOKING_CREATED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  PROGRAM_NEARING_DISCHARGE
  PATIENT_NEW
  PATIENT_SHARED
  SYSTEM
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   // recipient
  kind      NotificationKind
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId, userId, readAt])
  @@index([tenantId, createdAt])
}

// Per-user reminder dismissals — the "Más tarde" button on the dashboard
// records (userId, key, dismissedUntil). The reminder card hides itself
// until the date passes.
model DismissedReminder {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  reminderKey    String   // e.g. "near-discharge", "weekly-rollup"
  dismissedUntil DateTime
  createdAt      DateTime @default(now())

  @@unique([tenantId, userId, reminderKey])
}

// Per-user preferences — which KPIs are pinned to the dashboard, which
// palette is active, etc.
model UserPreferences {
  userId       String   @id
  tenantId     String?  // active tenant for the user (in case of multi-clinic)
  palette      String   @default("sky")
  pinnedKpis   Json     @default("[\"activePatients\",\"weekSessions\",\"activePrograms\"]")
  sidebarCollapsed Boolean @default(false)
  // Per-user agenda personalisation (Sprint 18). Each consultorio member
  // tailors their own week view; choices persist server-side so they
  // follow the user across devices and surface in /configuracion.
  agendaShowWeekHeader Boolean @default(true)
  agendaShowSaturday   Boolean @default(true)
  agendaShowSunday     Boolean @default(true)
  // Platform-catalog table state (page size, sort, active filters). A JSON blob
  // — same pattern as `pinnedKpis` — so adding a filter never needs a migration.
  // Validated defensively on read (see lib/preferences.ts).
  catalogPrefs Json?
  // B-pre M-agenda: estado de la agenda multi-profesional por usuario
  // ({mode, zoom 15|30|60, density, favoritePractitionerIds, locationId}).
  // Mismo patrón que `catalogPrefs`: blob validado al leer (lib/preferences.ts).
  agendaPrefs          Json?
  // M3a (ES3, plan §16.2): preferencias del dashboard ({revenueRange: 'month'|'week'}).
  // Blob validado al leer, como `agendaPrefs`. CHECK en la base
  // (UserPreferences_dashboardPrefs_object_check): NULL o un objeto JSON. Para
  // limpiarlo se escribe `Prisma.DbNull`; `Prisma.JsonNull` (null JSON) lo rechaza el CHECK.
  dashboardPrefs       Json?
  updatedAt    DateTime @updatedAt
}

// ═════════════════════════════════════════════════════════════════════
// Audit log — every PHI read/write
// ═════════════════════════════════════════════════════════════════════

model AuditEvent {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?  // userId, null for system
  action    String   // "patient.read", "case.create", etc.
  entity    String
  entityId  String?
  ip        String?
  userAgent String?
  payload   Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}

// ═════════════════════════════════════════════════════════════════════
// Catálogo global (B-pre M-cat): especialidades, prácticas, prestadoras
// ═════════════════════════════════════════════════════════════════════
// Datos de referencia compartidos por todos los tenants. Los importa Martin
// (scripts/catalog-import.ts) y los cura Plataforma, siempre por el canal
// `prismaService` (BYPASSRLS). El rol de la app solo LEE: RLS con una única
// policy `FOR SELECT USING (true)` y sin policy de escritura (default-deny).
// Excepción: PayerPlan, que admite planes propuestos por un consultorio
// (policy split como Exercise). Ver migración 20260930200000_catalog_global.
//
// Trazabilidad: cada fila guarda de qué fuente salió (`source`, `sourceRef`,
// `sourceDate`); `curatedAt` != null = editada a mano en Plataforma → el import
// nunca la pisa. `matchKey` = nombre normalizado (lib/catalog/normalize.ts)
// para deduplicar y sugerir vínculos.

enum CatalogSource {
  REFEPS
  NOMENCLADOR_NACIONAL
  PMO
  RNOS
  RNEMP
  PROVINCIAL
  CURATED
  TENANT
}

enum PayerKind {
  OBRA_SOCIAL
  PREPAGA
  MUTUAL
  OTRA
}

model Specialty {
  id         String        @id @default(cuid())
  slug       String        @unique
  name       String
  matchKey   String        @unique
  aliases    String[]
  source     CatalogSource
  sourceRef  String?
  sourceDate DateTime
  curatedAt  DateTime?
  archivedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  practices     PracticeSpecialty[]
  practitioners PractitionerSpecialty[]
}

model Practice {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  matchKey           String        @unique
  aliases            String[]
  code               String? // código de la práctica en su nomenclador
  nomenclador        String? // "Nacional", "IOMA", …
  defaultDurationMin Int?
  source             CatalogSource
  sourceRef          String?
  sourceDate         DateTime
  curatedAt          DateTime?
  archivedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  specialties PracticeSpecialty[]
  services    Service[]
}

model PracticeSpecialty {
  practiceId  String
  specialtyId String

  practice  Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([practiceId, specialtyId])
  @@index([specialtyId])
}

model Payer {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  legalName    String?
  kind         PayerKind
  registryCode String? // RNOS / RNEMP
  cuit         String?
  province     String?
  matchKey     String        @unique
  aliases      String[]
  source       CatalogSource
  sourceRef    String?
  sourceDate   DateTime
  curatedAt    DateTime?
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  plans    PayerPlan[]
  insurers Insurer[]
}

// Plan de una prestadora ("OSDE 210"). tenantId NULL = plan global del
// catálogo; tenantId set = propuesto por un consultorio (visible solo para él
// hasta que Plataforma lo promueva: `promotedAt`). Unicidad por SQL a mano
// (índices parciales, no expresables en Prisma): (payerId, slug) entre los
// globales y (payerId, tenantId, slug) entre los de tenant.
model PayerPlan {
  id         String        @id @default(cuid())
  payerId    String
  tenantId   String?
  name       String
  slug       String
  source     CatalogSource
  sourceDate DateTime
  promotedAt DateTime?
  archivedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Restrict: una prestadora con planes no se borra por accidente; el merge
  // de Plataforma repunta los planes antes de borrar la prestadora origen.
  payer     Payer      @relation(fields: [payerId], references: [id], onDelete: Restrict)
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coverages Coverage[]

  @@index([payerId])
  @@index([tenantId])
}

// Bitácora de cada corrida de scripts/catalog-import.ts --apply.
model CatalogImportRun {
  id        String   @id @default(cuid())
  file      String
  sha256    String
  kind      String // "specialties" | "practices" | "payers" | …
  created   Int
  updated   Int
  skipped   Int
  conflicts Json
  ranAt     DateTime @default(now())
  ranBy     String?
}

// ═════════════════════════════════════════════════════════════════════
// B-pre M-agenda (20261001090000_agenda_foundations): sedes, horario por
// profesional, excepciones, bloqueos y qué atiende/acepta cada profesional.
// Todas llevan tenantId + RLS (ENABLE + FORCE + tenantId = GUC) en la misma
// migración. CHECKs e índices parciales viven en el SQL (Prisma no los
// expresa): NO BORRARLOS si `prisma migrate dev` los propone como drift.
// FKs: CASCADE desde Tenant y desde Practitioner (config que no tiene sentido
// sin su dueño). En ScheduleException/TimeBlock `practitionerId` null significa
// "todo el consultorio": por eso CASCADE y NO SetNull — un SetNull convertiría
// el bloqueo de un profesional borrado en un bloqueo de todos.
// ═════════════════════════════════════════════════════════════════════

// Sede del consultorio. Cada tenant tiene exactamente una `isPrimary` (índice
// único parcial en SQL); `Booking.locationId` null = la principal.
model Location {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  address      String?
  addressLine2 String?
  city         String?
  province     String?
  postalCode   String?
  lat          Float?
  lng          Float?
  phone        String?
  isPrimary    Boolean  @default(false)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules  PractitionerSchedule[]
  timeBlocks TimeBlock[]
  bookings   Booking[]
  // Planes M1: sede del plan (RESTRICT).
  programs   TreatmentProgram[]
  // SR M4: salas de la sede (CASCADE por la FK compuesta Room_location_tenant_fkey).
  rooms      Room[]

  @@unique([id, tenantId], map: "Location_id_tenantId_key")
  @@index([tenantId])
}

// Franja semanal de atención de un profesional en una sede. Varias franjas por
// día (mañana/tarde, o sedes distintas) = varias filas.
//   dow: 0=Dom … 6=Sáb (convención de `toARDow` en lib/datetime-ar.ts, = JS
//        getDay). OJO: `expandBatchDates` de lib/booking-schedule.ts usa
//        0=Lun..6=Dom para su input; no mezclar.
//   startMin/endMin: minutos AR desde 00:00, [startMin, endMin).
//   validFrom/validUntil: vigencia opcional (día AR, inclusive).
// CHECKs en SQL: dow 0..6, 0 <= startMin < endMin <= 1440, validFrom <= validUntil.
model PractitionerSchedule {
  id             String    @id @default(cuid())
  tenantId       String
  practitionerId String
  locationId     String
  dow            Int
  startMin       Int
  endMin         Int
  validFrom      DateTime? @db.Date
  validUntil     DateTime? @db.Date
  // SR M4 (rooms): sala de la franja ("Consultorio 2 los lunes de 9 a 13"); null
  // = sin sala. La sala es de la sede de la franja y de este tenant (FKs
  // compuestas, ver "SR M4: DRIFT ACEPTADO").
  roomId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  // Cascade: la franja no existe sin su sede (las sedes se desactivan, no se
  // borran; un borrado real ya lo frena el RESTRICT de Booking.locationId).
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  // NoAction: una franja no se borra en silencio porque se borró su sala (las
  // salas se archivan). El borrado del tenant o de la sede no falla: lo prueba
  // tests/integration/rooms-m4.test.ts (ver la cabecera de la migración).
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: NoAction, map: "PractitionerSchedule_roomId_fkey")

  @@index([tenantId, practitionerId, dow])
  @@index([tenantId, roomId], map: "PractitionerSchedule_tenantId_roomId_idx")
}

enum ScheduleExceptionKind {
  CLOSED // ese día no se atiende
  CUSTOM_HOURS // ese día reemplaza la plantilla por `ranges`
}

// Excepción de un día puntual. `practitionerId` null = todo el consultorio.
// `ranges` = [{startMin,endMin,locationId}] (validado con zod al escribir;
// CHECK en SQL: CUSTOM_HOURS exige ranges). Únicos parciales en SQL: uno por
// (practitionerId, date) y uno por (tenantId, date) entre las de consultorio.
model ScheduleException {
  id             String                @id @default(cuid())
  tenantId       String
  practitionerId String?
  date           DateTime              @db.Date
  kind           ScheduleExceptionKind
  ranges         Json?
  reason         String?
  // UserProfile.id de quien la cargó. Sin FK a propósito: es autoría, no
  // pertenencia (no debe impedir borrar un usuario ni cascadear).
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  practitioner Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
}

// Bloqueo de agenda (candado del día, vacaciones, reunión). `practitionerId`
// null = todos los profesionales, incluidos los futuros (decisión 8); un
// subconjunto = N filas con el mismo `groupId`. `locationId` null = todas las
// sedes. Soft delete con `deletedAt`. CHECK en SQL: startsAt < endsAt.
// SR M4 (§17.5 "Bloquear sala"): con `roomId` el bloqueo es SOLO de esa sala y
// NO bloquea profesionales; el CHECK TimeBlock_room_scope_check exige
// `locationId` explícito y `practitionerId` null (null acá NO es "todos").
model TimeBlock {
  id             String    @id @default(cuid())
  tenantId       String
  practitionerId String?
  locationId     String?
  startsAt       DateTime
  endsAt         DateTime
  allDay         Boolean   @default(false)
  reason         String?
  groupId        String?
  roomId         String?
  createdById    String // UserProfile.id, sin FK (ver ScheduleException)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  practitioner Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  // Cascade y no SetNull: null = "todas las sedes", ampliaría el bloqueo.
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  // Cascade (§17.5): un bloqueo de una sala que se borra no tiene sentido.
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: Cascade, map: "TimeBlock_roomId_fkey")

  @@index([tenantId, startsAt])
  @@index([practitionerId, startsAt])
  @@index([tenantId, roomId, startsAt], map: "TimeBlock_tenantId_roomId_startsAt_idx")
}

enum RoomKind {
  CONSULTORIO
  BOX
  GIMNASIO
  SALA
}

// SR (M4 rooms, 20261009120000_rooms). Sala de una sede: consultorio, box,
// gimnasio o sala. `capacity` = cuántos PROFESIONALES atienden a la vez en la
// sala (SR-D1, §17.5; CHECK 1..50); el cupo de pacientes sigue en
// Service.maxConcurrent y el mismo profesional nunca choca consigo mismo. Se
// archiva con `active`, no se borra. Nombre único por sede entre las activas
// (índice parcial, SR-D9). Drift aceptado: ver "SR M4: DRIFT ACEPTADO" al final.
model Room {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  name       String
  kind       RoomKind @default(CONSULTORIO)
  capacity   Int      @default(1)
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "Room_tenantId_fkey")
  // FK compuesta: bajo BYPASSRLS (prod) la sala es de una sede del MISMO tenant.
  location   Location               @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction, map: "Room_location_tenant_fkey")
  schedules  PractitionerSchedule[]
  bookings   Booking[]
  timeBlocks TimeBlock[]

  @@unique([id, tenantId], map: "Room_id_tenantId_key")
  @@unique([id, locationId], map: "Room_id_locationId_key")
  @@index([tenantId, locationId], map: "Room_tenantId_locationId_idx")
}

enum PracticeVisibility {
  PUBLIC // se ofrece en el turnero público
  PRIVATE // solo la agenda interna
}

// Qué servicios atiende cada profesional y con qué reglas propias (ADR B-pre:
// sobre Service y no sobre la Practice del catálogo, porque Booking.serviceId,
// cupo, copago §5.5, facturación y webhook giran alrededor de Service). Los
// null heredan de Service (durationMin, maxConcurrent) o del tenant.
// `concurrencyOverride` = usar `maxConcurrent` de esta fila en vez del de
// Service (null con override = ilimitado).
model PractitionerService {
  id                  String             @id @default(cuid())
  tenantId            String
  practitionerId      String
  serviceId           String
  enabled             Boolean            @default(true)
  durationMin         Int?
  visibility          PracticeVisibility @default(PUBLIC)
  minLeadMinutes      Int?
  maxLeadDays         Int?
  concurrencyOverride Boolean            @default(false)
  maxConcurrent       Int?
  notifyOnBooking     Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([practitionerId, serviceId])
  @@index([tenantId, serviceId])
}

// Qué coberturas (Insurer del tenant, incl. Particular) acepta cada profesional.
model PractitionerPayer {
  id             String   @id @default(cuid())
  tenantId       String
  practitionerId String
  insurerId      String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  insurer      Insurer      @relation(fields: [insurerId], references: [id], onDelete: Cascade)

  @@unique([practitionerId, insurerId])
  @@index([tenantId, insurerId])
}

// Especialidades (catálogo global) de cada profesional. RESTRICT hacia
// Specialty: el catálogo se archiva, no se borra; un borrado real tiene que
// repuntar antes (no perder datos del tenant en silencio).
model PractitionerSpecialty {
  id             String @id @default(cuid())
  tenantId       String
  practitionerId String
  specialtyId    String

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  specialty    Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([practitionerId, specialtyId])
  @@index([tenantId])
  @@index([specialtyId])
}

// ═════════════════════════════════════════════════════════════════════
// Planes M1 (plans_booking_link) — portal y objetos que Prisma no expresa
// ═════════════════════════════════════════════════════════════════════

enum PatientChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Pedido de cambio "Mis datos" del portal (E3). Tabla aparte para que el portal
// NUNCA escriba la fila de Patient ni mueva Patient.updatedAt (lock de
// updatePatient). Un PENDING por paciente: índice único PARCIAL
// PatientChangeRequest_patient_pending_key (WHERE status='PENDING'). CHECKs en
// SQL: changes objeto JSON <= 4 KB; (status='PENDING') = (decidedAt IS NULL).
// RLS ENABLE + FORCE + PatientChangeRequest_tenant_isolation.
model PatientChangeRequest {
  id                String                     @id @default(cuid())
  tenantId          String
  patientId         String
  changes           Json
  status            PatientChangeRequestStatus @default(PENDING)
  requestedByUserId String?
  decidedById       String?
  decidedAt         DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @default(now()) @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "PatientChangeRequest_tenantId_fkey")
  // FK compuesta: bajo BYPASSRLS (prod) garantiza que el tenantId de la fila es el de la ficha.
  patient Patient @relation(fields: [patientId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction, map: "PatientChangeRequest_patient_tenant_fkey")

  @@index([tenantId, status], map: "PatientChangeRequest_tenantId_status_idx")
}

// ── Planes M1: DRIFT ACEPTADO (PLANES.md §3) ─────────────────────────────
// Estos objetos viven SOLO en prisma/migrations/20261004120000_plans_booking_link
// y Prisma no los expresa. Si `migrate dev` / `migrate diff` propone borrarlos,
// NO se borran (y `migrate dev` está prohibido en este repo):
//   • Únicos PARCIALES:
//       Session_programId_index_live_key            ON Session(programId, index) WHERE archivedAt IS NULL
//       Booking_session_active_key                  ON Booking(sessionId) WHERE sessionId IS NOT NULL AND status NOT IN ('CANCELLED','NO_SHOW')
//       ProgramAuthorization_programId_current_key  ON ProgramAuthorization(programId) WHERE supersededAt IS NULL
//       PatientChangeRequest_patient_pending_key    ON PatientChangeRequest(patientId) WHERE status = 'PENDING'
//   • FKs COMPUESTAS de Booking (las FK saltean RLS y prod es BYPASSRLS → I1/I4 en la base):
//       Booking_plan_tenant_fkey     (programId, tenantId)  → TreatmentProgram(id, tenantId)  ON DELETE RESTRICT
//       Booking_plan_patient_fkey    (programId, patientId) → TreatmentProgram(id, patientId) ON DELETE RESTRICT
//       Booking_session_program_fkey (sessionId, programId) → Session(id, programId)          ON DELETE RESTRICT
//   • CHECKs: TreatmentProgram_{pricing,price_nonneg,duration,schedule}_check,
//       Session_priceCents_check, Booking_{plan_link,plan_patient,priced_by_plan}_check,
//       PlanTemplate_{pricing,price_nonneg,duration,schedule}_check,
//       ProgramAuthorization_{sessions,code,dates}_check,
//       PatientChangeRequest_{changes,decided}_check.
//   • Policies RLS: ProgramAuthorization_tenant_isolation, PatientChangeRequest_tenant_isolation.
// Regla Prisma.DbNull: para limpiar un Json? (TreatmentProgram.schedule,
// PlanTemplate.schedule) se usa Prisma.DbNull, NUNCA Prisma.JsonNull: JsonNull
// guarda un JSON null, jsonb_typeof('null') = 'null' viola el CHECK object y la
// action revienta con 23514. Precedente: lib/practitioner-schedule.ts.

// ── SR M4: DRIFT ACEPTADO ────────────────────────────────────────────────
// Estos objetos viven SOLO en prisma/migrations/20261009120000_rooms y Prisma no
// los expresa. Si `migrate dev` / `migrate diff` propone borrarlos, NO se borran
// (y `migrate dev` está prohibido en este repo):
//   • Único PARCIAL + expresión (SR-D9):
//       Room_locationId_name_active_key  ON Room(locationId, lower(btrim(name))) WHERE active
//   • FKs COMPUESTAS (las FK saltean RLS y prod es BYPASSRLS → "misma empresa" y "misma sede" en la base):
//       Booking_room_tenant_fkey               (roomId, tenantId)   → Room(id, tenantId)   ON DELETE RESTRICT
//       Booking_room_location_fkey             (roomId, locationId) → Room(id, locationId) ON DELETE RESTRICT
//       PractitionerSchedule_room_tenant_fkey  (roomId, tenantId)   → Room(id, tenantId)   ON DELETE NO ACTION
//       PractitionerSchedule_room_location_fkey (roomId, locationId) → Room(id, locationId) ON DELETE NO ACTION
//       TimeBlock_room_tenant_fkey             (roomId, tenantId)   → Room(id, tenantId)   ON DELETE CASCADE
//       TimeBlock_room_location_fkey           (roomId, locationId) → Room(id, locationId) ON DELETE CASCADE
//   • CHECKs: Room_{name,capacity,sortOrder}_check, Booking_room_location_check (sala ⇒ sede explícita, SR-D6),
//       TimeBlock_room_scope_check (sala ⇒ sede explícita y sin profesional, §17.5).
//   • Policy RLS: Room_tenant_isolation.
