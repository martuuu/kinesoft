ground:rgba(15,30,51,0.12);margin:0 4px"></span><div role="group" aria-label="Resaltar turnos de plan o sueltos" style="display:inline-flex;flex-wrap:wrap;align-items:center;gap:8px"><span style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--navy-300);margin-right:4px">Turnos</span><button type="button" data-plan-scope="plan" aria-pressed="false" aria-label="De plan, 0 turnos" title="Resaltar los turnos que son sesiones de un plan" style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;border:1px solid rgba(15,30,51,0.12);background:transparent;font-size:11.5px;font-weight:600;color:var(--navy-700);cursor:pointer"><span aria-hidden="true" style="display:inline-flex;align-items:center;padding:0 4px;border-radius:999px;border:1px solid var(--navy-500);font-size:9px;font-weight:700;line-height:1.3;color:var(--navy-700);background:#fff">n/N</span>De plan<span style="color:var(--navy-500);font-weight:600">0</span></button><button type="button" data-plan-scope="loose" aria-pressed="false" aria-label="Sueltos, 6 turnos" title="Resaltar los turnos sueltos (sin plan)" style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;border:1px solid rgba(15,30,51,0.12);background:transparent;font-size:11.5px;font-weight:600;color:var(--navy-700);cursor:pointer"><span aria-hidden="true" style="width:10px;height:10px;border-radius:999px;border:1.5px dashed var(--navy-500);flex-shrink:0;box-sizing:border-box"></span>Sueltos<span style="color:var(--navy-500);font-weight:600">6</span></button></div></div></div>"
