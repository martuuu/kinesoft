0;border:1px solid rgba(15,30,51,0.12);background:rgba(255,255,255,0.7);color:var(--navy-700);cursor:pointer;white-space:nowrap;overflow:hidden"><button type="button" aria-pressed="false" aria-label="Elena Martínez, 1 turno" title="Elena Martínez" style="display:inline-flex;align-items:center;gap:6px;height:100%;padding:0 4px 0 4px;border:none;background:transparent;color:inherit;font:inherit;cursor:pointer;max-width:200px"><span aria-hidden="true" data-initials="EM" style="width:22px;height:22px;border-radius:50%;flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;letter-spacing:0.02em;line-height:1;color:var(--navy-700);background:#fff;border:1.5px solid var(--navy-200)">EM</span><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Elena Martínez</span><span class="k-mono" aria-hidden="true" style="font-size:10.5px;font-weight:700;min-width:18px;text-align:center;border-radius:999px;padding:0 5px;background:rgba(15,30,51,0.06);color:var(--navy-500)">1</span></button><button type="button" aria-pressed="false" aria-label="Marcar a Elena Martínez como favorito" title="Marcar como favorito" style="display:inline-flex;align-items:center;justify-content:center;width:26px;height:100%;border:none;background:transparent;color:var(--navy-200);cursor:pointer;padding-right:4px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 3 7 7 .6-5.3 4.7L18 22l-6-3.6L6 22l1.3-7.7L2 9.6 9 9z"></path></svg></button></span><span data-chip="p6" style="display:inline-flex;align-items:center;gap:0;height:32px;padding:0;border-radius:999px;font-size:12.5px;font-weight:600;border:1px solid rgba(15,30,51,0.12);background:rgba(255,255,255,0.7);color:var(--navy-700);cursor:pointer;white-space:nowrap;overflow:hidden"><button type="button" aria-pressed="false" aria-label="Federico Sosa, 1 turno" title="Federico Sosa" style="display:inline-flex;align-items:center;gap:6px;height:100%;padding:0 4px 0 4px;border:none;background:transparent;color:inherit;font:inherit;cursor:pointer;max-width:200px"><span aria-hidden="true" data-initials="FS" style="width:22px;height:22px;border-radius:50%;flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;letter-spacing:0.02em;line-height:1;color:var(--navy-700);background:#fff;border:1.5px solid var(--navy-200)">FS</span><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Federico Sosa</span><span class="k-mono" aria-hidden="true" style="font-size:10.5px;font-weight:700;min-width:18px;text-align:center;border-radius:999px;padding:0 5px;background:rgba(15,30,51,0.06);color:var(--navy-500)">1</span></button><button type="button" aria-pressed="false" aria-label="Marcar a Federico Sosa como favorito" title="Marcar como favorito" style="display:inline-flex;align-items:center;justify-content:center;width:26px;height:100%;border:none;background:transparent;color:var(--navy-200);cursor:pointer;padding-right:4px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 3 7 7 .6-5.3 4.7L18 22l-6-3.6L6 22l1.3-7.7L2 9.6 9 9z"></path></svg></button></span></div></header><div class="_strip_7e00d9" style="grid-template-columns:repeat(6, minmax(0, 1fr))"><button type="button" aria-current="date" class="_stripDay_7e00d9"><span class="_stripTop_7e00d9"><span class="_stripLabel_7e00d9">lun</span><span class="k-display _stripNum_7e00d9">5</span></span><span class="_stripCount_7e00d9">7<span class="_stripWord_7e00d9"> turnos</span></span></button><button type="button" class="k-glass _stripDay_7e00d9"><span class="_stripTop_7e00d9"><span class="_stripLabel_7e00d9">mar</span><span class="k-display _stripNum_7e00d9">6</span></span><span class="_stripCount_7e00d9">0<span class="_stripWord_7e00d9"> turnos</span></span></button><button type="button" class="k-glass _stripDay_7e00d9"><span class="_stripTop_7e00d9"><span class="_stripLabel_7e00d9">mié</span><span class="k-display _stripNum_7e00d9">7</span></span><span class="_stripCount_7e00d9">2<span class="_stripWord_7e00d9"> turnos</span></span></button><button type="button" class="k-glass _stripDay_7e00d9"><span class="_stripTop_7e00d9"><span class="_stripLabel_7e00d9">jue</span><span class="k-display _stripNum_7e00d9">8</span></span><span class="_stripCount_7e00d9">0<span class="_stripWord_7e00d9"> turnos</span></span></button><button type="button" class="k-glass _stripDay_7e00d9"><span class="_stripTop_7e00d9"><span class="_stripLabel_7e00d9">vie</span><span class="k-display _stripNum_7e00d9">9</span></span><span class="_stripCount_7e00d9">0<span class="_stripWord_7e00d9"> turnos</span></span></button><button type="button" class="k-glass _stripDay_7e00d9"><span class="_stripTop_7e00d9"><span class="_stripLabel_7e00d9">sáb</span><span class="k-display _stripNum_7e00d9">10</span></span><span class="_stripCount_7e00d9">0<span class="_stripWord_7e00d9"> turnos</span></span></button></div><div style="flex:1;min-height:0"><div class="k-page-in" style="height:100%"><section class="rcp" aria-labelledby="rcp-title"><style>
.rcp { display: grid; gap: 12px; }
.rcp-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.rcp-head { display: flex; justify-content: flex-end; }
.rcp-desk-link { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 6px 12px; border-radius: 999px; font-size: 12.5px; font-weight: 600; color: var(--sky-700); border: 1px solid rgba(15,30,51,0.12); background: var(--card-bg); text-decoration: none; }
.rcp-desk-link:hover { border-color: var(--sky-700); }
.rcp-desk-link:focus-visible { outline: 2px solid var(--sky-700); outline-offset: 2px; }
.rcp-counters { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
.rcp-counter { background: var(--card-bg); border: 1px solid rgba(15,30,51,0.06); border-radius: var(--r-md); padding: 10px 14px; }
.rcp-counter[data-warn] { border-color: var(--warn-border); background: var(--warn-bg); }
.rcp-counter-label { font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--navy-300); }
.rcp-counter-value { font-size: 22px; font-weight: 700; color: var(--navy-900); line-height: 1.2; }
.rcp-counter-hint { font-size: 11px; color: var(--navy-500); }
.rcp-filters { display: flex; flex-wrap: wrap; gap: 6px; }
.rcp-chip { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; font-size: 12.5px; font-weight: 600; border: 1px solid rgba(15,30,51,0.12); background: #fff; color: var(--navy-700); cursor: pointer; }
.rcp-chip[aria-pressed=&quot;true&quot;] { background: var(--navy-900); border-color: var(--navy-900); color: #fff; }
.rcp-chip-n { font-family: &quot;JetBrains Mono&quot;, ui-monospace, monospace; font-size: 11px; opacity: 0.75; }
.rcp-note { margin: 0; font-size: 12.5px; color: var(--navy-500); }
.rcp-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.rcp-table thead th { padding: 12px 14px; text-align: left; font-size: 10px; font-weight: 700; color: var(--navy-300); letter-spacing: 0.06em; text-transform: uppercase; border-bottom: 1px solid rgba(15,30,51,0.06); }
.rcp-row &gt; td, .rcp-row &gt; th { padding: 10px 14px; border-bottom: 1px solid rgba(15,30,51,0.04); vertical-align: middle; text-align: left; font-weight: inherit; }
.rcp-row[data-highlight] { background: var(--warn-bg); box-shadow: inset 3px 0 0 var(--warn-fg); }
.rcp-time { font-weight: 700; color: var(--navy-700); white-space: nowrap; }
.rcp-patient { min-width: 140px; }
.rcp-link { background: none; border: none; padding: 0; font: inherit; font-weight: 600; color: var(--navy-900); cursor: pointer; text-align: left; }
.rcp-link:hover { text-decoration: underline; }
.rcp-guest { margin-left: 6px; font-size: 10px; font-weight: 700; color: var(--navy-500); border: 1px solid rgba(15,30,51,0.15); border-radius: 999px; padding: 1px 6px; white-space: nowrap; }
.rcp-service { display: inline-flex; align-items: center; gap: 8px; min-width: 0; max-width: 220px; color: var(--navy-700); }
.rcp-dot { width: 10px; height: 10px; border-radius: 999px; flex-shrink: 0; }
.rcp-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rcp-tag { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
.rcp-wait { font-size: 12px; color: var(--navy-700); white-space: nowrap; }
.rcp-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; }
.rcp-btn { display: inline-flex; align-items: center; padding: 6px 11px; min-height: 32px; border-radius: 999px; font-size: 12px; font-weight: 600; border: 1px solid rgba(15,30,51,0.14); background: #fff; color: var(--navy-900); cursor: pointer; white-space: nowrap; }
.rcp-btn-primary { background: var(--sky-700); border-color: var(--sky-700); color: #fff; }
.rcp-btn-ghost { background: transparent; color: var(--navy-700); }
.rcp-btn:disabled { opacity: 0.5; cursor: progress; }
.rcp-btn:focus-visible, .rcp-chip:focus-visible, .rcp-link:focus-visible { outline: 2px solid var(--sky-700); outline-offset: 2px; }

/* [MB-1b · C-MB4] Escritorio chico (1366/1024 × 625 en el navegador, 695 en la PWA). KPIs en una línea (franja de
   ~38 px; antes ~75), el link al escritorio de Recepción a la derecha de los filtros (antes un renglón propio) y
   filas de ~42 px: con la toolbar de la agenda arriba entran ≥ 6 filas a 625 y ≥ 8 a 695. La tabla scrollea adentro
   con el encabezado sticky (el alto lo fija reception-fit.ts). Monitores altos y celular: como siempre. */
@media (min-width: 1024px) and (max-height: 820px) {
  .rcp { grid-template-columns: minmax(0, 1fr) auto; gap: 10px 12px; }
  .rcp &gt; * { grid-column: 1 / -1; }
  .rcp-counters { grid-row: 1; }
  .rcp-filters { grid-row: 2; grid-column: 1; }
  .rcp-head { grid-row: 2; grid-column: 2; align-self: center; }
  .rcp-counter { display: flex; align-items: baseline; gap: 8px; min-width: 0; padding: 6px 12px; }
  .rcp-counter-label, .rcp-counter-hint { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .rcp-counter-value { font-size: 18px; flex-shrink: 0; }
  .rcp-table thead th { padding-top: 8px; padding-bottom: 8px; }
  .rcp-row &gt; td, .rcp-row &gt; th { padding-top: 5px; padding-bottom: 5px; }
  .rcp-scroll { overflow: auto; overscroll-behavior: contain; }
  .rcp-scroll thead th { position: sticky; top: 0; z-index: 1; background: var(--card-bg); }
}

/* [MB-1b] Táctil: 44 px mínimos bajo 768 (AGENTS §5). Entre 640 y 767 sigue la tabla, con filas más altas. */
@media (max-width: 767px) {
  .rcp-btn, .rcp-chip, .rcp-desk-link { min-height: 44px; }
  .rcp-btn { padding: 8px 14px; }
  /* inline-block (no flex) para que el nombre largo siga cortando con «…»; el title lo muestra entero. */
  .rcp-link { display: inline-block; vertical-align: middle; line-height: 44px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
}

@media (max-width: 639px) {
  .rcp-counters { gap: 6px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .rcp-counter { padding: 8px 10px; }
  .rcp-counter-value { font-size: 18px; }
  .rcp-table, .rcp-table tbody { display: block; }
  .rcp-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  /* G8 (VX0-b): card de 2 líneas, «hora + paciente» arriba y «servicio · profesional · estado · espera» abajo, con
     las acciones a la derecha. Antes cada celda era una línea con su rótulo en mayúsculas (~140 px por turno: 10
     turnos = 1.500 px). Flex con «order»: el «::before» de la fila (ancho 100 %, alto 0) fuerza el corte de línea
     entre las dos; las celdas siguen siendo «td»/«th» de la misma fila (la tabla no cambia para el lector). */
  .rcp-row { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; padding: 10px 12px; border-bottom: 1px solid rgba(15,30,51,0.06); }
  .rcp-row::before { content: &quot;&quot;; order: 2; flex-basis: 100%; height: 0; }
  .rcp-row &gt; td, .rcp-row &gt; th { display: block; padding: 0; border: none; min-width: 0; }
  .rcp-row &gt; .rcp-time { order: 0; font-size: 15px; }
  .rcp-row &gt; .rcp-patient { order: 0; flex: 1 1 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rcp-row &gt; .rcp-actions-cell { order: 1; margin-left: auto; max-width: 60%; }
  .rcp-row &gt; td:not(.rcp-time):not(.rcp-actions-cell) { order: 3; font-size: 12px; color: var(--navy-500); max-width: 100%; }
  .rcp-row &gt; td:not(.rcp-time):not(.rcp-actions-cell) + td:not(.rcp-actions-cell)::before { content: &quot;· &quot;; color: var(--navy-300); }
  .rcp-row .rcp-service { max-width: 160px; vertical-align: middle; }
  .rcp-actions { justify-content: flex-end; }
}
