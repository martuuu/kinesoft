a-pressed="false" aria-label="Mis favoritos, 1 turno" style="display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 12px;border-radius:999px;font-size:12.5px;font-weight:600;border:1px solid rgba(15,30,51,0.12);background:rgba(255,255,255,0.7);color:var(--navy-700);cursor:pointer;white-space:nowrap;opacity:1"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 3 7 7 .6-5.3 4.7L18 22l-6-3.6L6 22l1.3-7.7L2 9.6 9 9z"></path></svg> Favoritos <span class="k-mono" aria-hidden="true" style="font-size:10.5px;font-weight:700;min-width:18px;text-align:center;border-radius:999px;padding:0 5px;background:rgba(15,30,51,0.06);color:var(--navy-500)">1</span></button><span aria-hidden="true" style="width:1px;height:20px;background:rgba(15,30,51,0.12);margin:0 2px"></span><span data-chip="p3" style="display:inline-flex;align-items:center;gap:0;height:32px;padding:0;border-radius:999px;font-size:12.5px;font-weight:600;border:1px solid rgba(15,30,51,0.12);background:rgba(255,255,255,0.7);color:var(--navy-700);cursor:pointer;white-space:nowrap;overflow:hidden"><button type="button" aria-pressed="false" aria-label="Carla Gómez, 1 turno" title="Carla Gómez" style="display:inline-flex;align-items:center;gap:6px;height:100%;padding:0 4px 0 4px;border:none;background:transparent;color:inherit;font:inherit;cursor:pointer;max-width:200px"><span aria-hidden="true" data-initials="CG" style="width:22px;height:22px;border-radius:50%;flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;letter-spacing:0.02em;line-height:1;color:var(--navy-700);background:#fff;border:1.5px solid var(--navy-200)">CG</span><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Carla Gómez</span><span class="k-mono" aria-hidden="true" style="font-size:10.5px;font-weight:700;min-width:18px;text-align:center;border-radius:999px;padding:0 5px;background:rgba(15,30,51,0.06);color:var(--navy-500)">1</span></button><button type="button" aria-pressed="true" aria-label="Quitar a Carla Gómez de favoritos" title="Quitar de favoritos" style="display:inline-flex;align-items:center;justify-content:center;width:26px;height:100%;border:none;background:transparent;color:var(--navy-900);cursor:pointer;padding-right:4px"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 3 7 7 .6-5.3 4.7L18 22l-6-3.6L6 22l1.3-7.7L2 9.6 9 9z"></path></svg></button></span><span data-chip="p1" style="display:inline-flex;align-items:center;gap:0;height:32px;padding:0;border-radius:999px;font-size:12.5px;font-weight:600;border:1px solid rgba(15,30,51,0.12);background:rgba(255,255,255,0.7);color:var(--navy-700);cursor:pointer;white-space:nowrap;overflow:hidden"><button type="button" aria-pressed="false" aria-label="Ana Pérez, 2 turnos" title="Ana Pérez" style="display:inline-flex;align-items:center;gap:6px;height:100%;padding:0 4px 0 4px;border:none;background:transparent;color:inherit;font:inherit;cursor:pointer;max-width:200px"><span aria-hidden="true" data-initials="AP" style="width:22px;height:22px;border-radius:50%;flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;letter-spacing:0.02em;line-height:1;color:var(--navy-700);background:#fff;border:1.5px solid var(--navy-200)">AP</span><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Ana Pérez</span><span class="k-mono" aria-hidden="true" style="font-size:10.5px;font-weight:700;min-width:18px;text-align:center;border-radius:999px;padding:0 5px;background:rgba(15,30,51,0.06);color:var(--navy-500)">2</span></button><button type="button" aria-pressed="false" aria-label="Marcar a Ana Pérez como favorito" title="Marcar como favorito" style="display:inline-flex;align-items:center;justify-c