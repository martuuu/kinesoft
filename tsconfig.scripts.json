{
  // Typecheck de los scripts de Planes (S02x en adelante): el tsconfig raíz
  // excluye `scripts/`, y `scripts/tsconfig.json` (commonjs) incluye TODO
  // scripts/, con deuda vieja que no es de esta ola. Acá entran solo los
  // scripts de Planes y `scripts/lib`; lo que importen de `lib/` se chequea
  // por arrastre. `incremental: false` para no dejar un .tsbuildinfo suelto.
  // SV04b: también `scripts/realtime-verify.ts` (V1-V6 de staging); compila
  // aunque `ws` no esté instalado (import dinámico con especificador en variable).
  // IAM-0b: `scripts/diagnose-email.ts` (prueba del canal de mail).
  // TP-2h: `scripts/diagnose-mp-connect.ts` (S1–S11 de Mercado Pago Connect).
  // MPS-2c: `scripts/saas-reanchor.ts` (re-anclaje de las suscripciones al día 4; lo corre Martin).
  // INF-S: `scripts/prod-precheck.ts` (pre/post del día del push) y `scripts/qa-tenants.ts` (consultorios QA por plan);
  // sus núcleos ya entran por `scripts/lib/**`. Los dos los corre Martin.
  // Uso: npx tsc --noEmit -p tsconfig.scripts.json
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": ["scripts/plans-*.ts", "scripts/realtime-verify.ts", "scripts/diagnose-email.ts", "scripts/diagnose-auth.ts",
    "scripts/diagnosis-import.ts", "scripts/secret-box-rotate.ts", "scripts/diagnose-mp-connect.ts", "scripts/saas-reanchor.ts",
    "scripts/prod-precheck.ts", "scripts/qa-tenants.ts",
    "scripts/lib/**/*.ts"],
  "exclude": ["node_modules"]
}
