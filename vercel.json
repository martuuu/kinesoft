{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "buildCommand": "node scripts/vercel-build.mjs",
  "functions": {
    "app/api/consultorio/export/route.ts": {
      "maxDuration": 60
    },
    "app/**/*": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/invitations-expire",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/health-digest",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/trial-reminders",
      "schedule": "0 12 * * *"
    }
  ]
}
