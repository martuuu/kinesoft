{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "buildCommand": "node scripts/vercel-build.mjs",
  "functions": {
    "app/api/consultorio/export/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/daily/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/whatsapp/route.ts": {
      "maxDuration": 60
    },
    "app/api/pacientes/[id]/historia-clinica/[format]/route.ts": {
      "maxDuration": 60
    },
    "app/**/*": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/whatsapp",
      "schedule": "0 21 * * *"
    }
  ]
}
